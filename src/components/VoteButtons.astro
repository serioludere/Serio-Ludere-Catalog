---
// Reactions (brief §7; owner, 2026-09-15: dislikes removed). One control — a like — on the grid card
// and on the detail page alike. `data-source` still records which surface the like came from.
//
// The control is a real <button> whose accessible name is text content ("Like this rug"), visually
// hidden next to the icon — not an `aria-label` on an icon. That is what the brief asks for, and it
// is what voice control needs: "click Like this rug" works, an aria-label does not always. The
// circle stays 32 px; the tap target is padded to 44 px on coarse pointers.
interface Props {
  rugId: string;
  /** Where the like is offered: `card` on the grid, `detail` on the rug's own page. */
  mode?: 'card' | 'detail';
}
const { rugId, mode = 'card' } = Astro.props;
---

<div class:list={['like', { 'like-detail': mode === 'detail' }]}>
  <button type="button" aria-pressed="false" data-vote="like" data-source={mode} data-rug={rugId}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
      ><path
        d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.3 5 6.8 5c2 0 3.4 1.1 4.2 2.3C11.8 6.1 13.2 5 15.2 5c3.5 0 5.6 3.6 4.3 6.8C19.5 16.4 12 21 12 21z"
      ></path></svg
    >
    <span class="sr-only">Like this rug</span>
  </button>
</div>

<script>
  import { initVotes } from '../scripts/votes.ts';
  initVotes();
</script>
