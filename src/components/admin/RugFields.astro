---
// The rug field grid shared by /admin/rugs/new (add mode: name + collection + tags + supplier link
// → Fetch → preview) and /admin/rugs/[id] (edit mode: the same grid with id readonly, a hidden
// version, Save / Archive / Restore). docs/ADMIN_SPEC.md §8.3. Wired by src/scripts/admin/rug-form.ts;
// nothing inline (hash CSP), sheet text only ever lands as text.
import type { AdminCollection, AdminRug, AdminTag } from '../../lib/admin/read.ts';
import { driveImageUrl } from '../../lib/images.ts';
import { BADGE_TAG_NAMES } from '../../lib/view.ts';
import { METHOD_OPTIONS, otherMethods, splitMethods } from '../../lib/method.ts';
import Chips from './Chips.astro';
import MultiSelect from '../ui/MultiSelect.astro';

interface Props {
  mode: 'add' | 'edit';
  rug?: AdminRug;
  collections: readonly AdminCollection[];
  tags: readonly AdminTag[];
  roundStep: number;
  driveScopeOk: boolean | null;
  nextId?: string;
  /**
   * False inside the Add-product drawer, whose FOOTER owns Fetch (Figma P3 80:1480 draws the action
   * in the footer bar, not floating inline mid-body). The standalone /admin/rugs/new page — the
   * no-JS fallback — has no footer, so it keeps the inline control. rug-form.ts finds the button by
   * id across the whole document, so it does not care which of the two rendered it.
   */
  fetchButton?: boolean;
  /** Distinct customers currently liking the rug (edit mode); the admin read itself has no counts. */
  likes?: number;
}
const {
  mode,
  rug,
  collections,
  tags,
  roundStep,
  driveScopeOk,
  nextId,
  fetchButton = true,
  likes = 0,
} = Astro.props;
const edit = mode === 'edit';
/** "4 Sep 2026" for the meta line; the sheet stores ISO timestamps nobody should have to read. */
const day = (iso: string | undefined): string => {
  const t = iso ? Date.parse(iso) : Number.NaN;
  return Number.isFinite(t)
    ? new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
    : '—';
};
/** The read-only footer under the edit form, one string so it never wraps mid-phrase. */
const metaLine = rug ? `${likes} ${likes === 1 ? 'like' : 'likes'} · added ${day(rug.scrapedAt)}` : '';
const v = (s: string | number | undefined): string => (s === undefined ? '' : String(s));
// The product's OWN tags (owner, 2026-09-18) — there is no registry to offer any more.
const ownTags = rug?.tags.filter((t) => t.trim()) ?? [];
// The markers (owner, 2026-09-20): the two tags a buyer sees on the card, offered as toggle buttons
// on both the add and the edit form. Not a registry coming back — they are ordinary tag strings, and
// a product may carry neither, one or both. BADGE_TAG_NAMES is the one list, shared with the cards.
const PRESET_TAGS = BADGE_TAG_NAMES;
// Membership, not the primary: the form must tick every collection the rug is filed under.
const chosenCollections = new Set((rug?.collections ?? []).map((c) => c.trim().toLowerCase()));
// The techniques this rug carries, canonically spelled, so the boxes come up ticked (owner, 2026-09-20).
const chosenMethods = new Set(splitMethods(rug?.method));
---

{
  /* The add strip. Every control carries a VISIBLE label: these were placeholder-only, and a
    placeholder disappears the moment you type — so the one time you need to know what a field is
    (checking what you just entered) is the one time nothing tells you. The revealed `.fields` grid
    below always had labels; this brings the top of the form up to the same standard. */
}
<div class="addform">
  {
    /* Owner, 2026-09-16: adding a product no longer asks for the number. The server has already
      allocated the next one, nobody typed it, and a field you cannot usefully change is noise at the
      top of the drawer — so on add it rides along hidden and rug-form.ts reads it exactly as before.
      Editing still shows it, read-only: there it is the row's reference, not an input. */
    edit ? (
      <div class="f">
        <label for="f_id">Product number</label>
        <input id="f_id" value={rug?.id ?? ''} readonly autocomplete="off" />
        <p class="hint">Must be unique — it becomes the product's reference number.</p>
      </div>
    ) : (
      <input type="hidden" id="f_id" value={nextId ?? ''} />
    )
  }

  <div class="row">
    {
      !edit && (
        <div class="f grow">
          <label for="yourName">Product name</label>
          <input id="yourName" placeholder="e.g. Khal Mohammadi" autocomplete="off" />
        </div>
      )
    }
    <div class="f narrow">
      <span class="f__legend">Collections</span>
      <MultiSelect
        id="f_collection"
        name="collection"
        label="Collections"
        placeholder="Choose collections…"
        required
        options={collections.map((c) => ({
          value: c.name,
          label: c.name,
          selected: chosenCollections.has(c.name.trim().toLowerCase()),
        }))}
      />
    </div>
  </div>

  {
    /* Owner, 2026-09-18: tags are plain strings on THIS product, not a registry to pick from. What is
      listed is what the product has; each carries an × that removes it, and the input adds one. */
  }
  <div class="f">
    <span class="f__legend">Tags</span>
    <div class="tagrow">
      {
        /* The markers (owner, 2026-09-20). Pressing one adds that tag, pressing it again removes it;
           anything else is still typed below. rug-form.ts keeps these in step with the tokens, so a
           marker removed by its × comes un-pressed here too. */
      }
      <div class="tagpresets">
        {
          PRESET_TAGS.map((t) => (
            <button
              type="button"
              class="chip tagpreset"
              data-preset={t}
              aria-pressed={
                ownTags.some((own) => own.trim().toLowerCase() === t.toLowerCase()) ? 'true' : 'false'
              }
            >
              {t}
            </button>
          ))
        }
      </div>
      <div class="tagtokens" id="tagChips" role="list" aria-label="Tags on this product">
        {
          ownTags.map((t) => (
            <span class="tagtoken" data-tag={t} role="listitem">
              <span class="tagtoken__label">{t}</span>
              <button type="button" class="tagtoken__x" data-remove={t} aria-label={`Remove ${t}`}>
                ×
              </button>
            </span>
          ))
        }
      </div>
      <div class="newtag">
        <label class="sr-only" for="newTag">New tags, separated by commas</label>
        <input id="newTag" placeholder="New tags, separated by commas" autocomplete="off" />
        <button class="chip" id="btnNewTag" type="button"> Add tags </button>
      </div>
    </div>
  </div>
  {
    !edit && (
      <>
        <div class="f">
          <label for="url">Supplier product link</label>
          <div class="row">
            <div class="grow">
              <input
                id="url"
                placeholder="ecarpetgallery.com or karavanrug.com"
                inputmode="url"
                autocomplete="off"
              />
            </div>
            {fetchButton && (
              <button class="btn btn--primary" id="btnFetch" type="button">
                Fetch
              </button>
            )}
          </div>
        </div>
        <p class="hint">
          The name is what customers see. The supplier link fills in size, material, age and price.
        </p>
        <p class="hint" id="supplierTitle" hidden />
        <div id="m1" class="msg" />
      </>
    )
  }
</div>

<div id="preview" class:list={['preview', { on: edit }]}>
  <div class="fields">
    <div class="f">
      <label for="f_slug">Web address</label>
      <div class="pair">
        <input id="f_slug" value={rug?.slug ?? ''} autocomplete="off" />
        <button class="chip" id="btnSlug" type="button" title="Regenerate from the name">↻</button>
      </div>
    </div>
    <div class="f">
      <label for="f_name">Name (shown to customers)</label>
      <input id="f_name" value={rug?.name ?? ''} autocomplete="off" />
    </div>
    <div class="f wide">
      <label for="f_description">Description</label>
      {
        /* Six rows, not three (owner, 2026-09-20): this is the paragraph the buyer reads under the
          rug, and editing it three lines at a time — inside what used to be a 480px drawer — meant
          scrolling a box to re-read your own sentence. It resizes vertically from there. */
      }
      <textarea id="f_description" rows="6">{rug?.description ?? ''}</textarea>
    </div>
    <div class="f">
      <label for="f_width">Width (cm)</label>
      <input id="f_width" inputmode="numeric" value={v(rug?.widthCm)} />
    </div>
    <div class="f">
      <label for="f_length">Length (cm)</label>
      <div class="pair">
        <input id="f_length" inputmode="numeric" value={v(rug?.lengthCm)} />
        <button class="chip" id="btnSwap" type="button" title="Swap width and length">⇄</button>
      </div>
    </div>
    <div class="f">
      <label for="f_material">Material</label>
      <input id="f_material" value={rug?.material ?? ''} />
    </div>
    <div class="f">
      {
        /* Four techniques as checkboxes (owner, 2026-09-20), not a free-text box: the studio was typing
          the same four strings, three spellings apart. A rug may carry more than one — a piece can be
          both flatweave and hand-loomed — and rug-form.ts joins what is ticked back into the single
          `Method` cell the sheet, the spec panel and the Shopify export all still read.

          Anything a row already carries that is NOT one of the four (a scraped "Handmade pile rug")
          rides along as an extra ticked option rather than being silently dropped on the next save. */
      }
      <span class="f__legend">Method</span>
      <div id="f_method" class="methods" role="group" aria-label="Method">
        {
          [...METHOD_OPTIONS, ...otherMethods(rug?.method)].map((m) => (
            <label class="chk">
              <input type="checkbox" data-method value={m} checked={chosenMethods.has(m)} />
              {m}
            </label>
          ))
        }
      </div>
    </div>
    <div class="f">
      <label for="f_age">Age</label>
      <input id="f_age" value={rug?.age ?? ''} />
    </div>
    <div class="f">
      <label for="f_origin">Origin</label>
      <input id="f_origin" value={rug?.origin ?? ''} />
    </div>
    <div class="f">
      <label for="f_price">Retail price (USD)</label>
      <div class="pair">
        <input id="f_price" inputmode="decimal" value={v(rug?.priceUsd)} />
        <button class="chip" id="btnRound" type="button">Round to {roundStep}</button>
      </div>
    </div>
    {
      /* "Rotate photo" asked a question the studio should never have to answer (owner, 2026-09-20):
         a Karavan cover arrives on its side and is turned a quarter to the LEFT on import, always
         (src/lib/drive/transform.ts), so by the time a photo is stored it is already the right way
         up. The control is gone from both forms; the stored value rides along hidden so an existing
         row keeps whatever display hint it already had. */
    }
    <select id="f_rotate" hidden>
      <option value="false" selected={(rug?.rotate ?? 'false') === 'false'}>No</option>
      <option value="true" selected={rug?.rotate === 'true'}>Turn to portrait</option>
      <option value="force" selected={rug?.rotate === 'force'}>Always turn</option>
    </select>
    {
      /* "Featured" is gone from both forms (owner, 2026-09-20). The column still exists and still
         orders the catalogue, so the value RIDES ALONG hidden rather than being cleared on every
         save — removing the control must not silently un-feature a rug that is featured. */
    }
    <input type="checkbox" id="f_featured" checked={rug?.featured === true} hidden />
    <div class="f">
      <label for="f_sourceUrl">Supplier link</label>
      <input id="f_sourceUrl" inputmode="url" value={rug?.sourceUrl ?? ''} autocomplete="off" />
    </div>
    <div class="f">
      <label for="f_supplier">Supplier</label>
      <select id="f_supplier">
        <option value="" selected={!rug?.supplier}>Owned / other</option>
        <option value="ecarpetgallery" selected={rug?.supplier === 'ecarpetgallery'}>ECG</option>
        <option value="karavanrug" selected={rug?.supplier === 'karavanrug'}>KV</option>
      </select>
    </div>
    <div class="f">
      <label for="f_supplierRef">Supplier ref</label>
      <input id="f_supplierRef" value={rug?.supplierRef ?? ''} autocomplete="off" />
    </div>
    <div class="f wide">
      <label for="f_notes">Notes (internal)</label>
      <textarea id="f_notes" rows="2">{rug?.notes ?? ''}</textarea>
    </div>
  </div>

  <p class="hint" id="ftHint" hidden></p>
  <p class="hint" id="priceHint" hidden></p>
  <p class="hint" id="tagHint" hidden></p>
  <ul class="hint warnings" id="warnings" hidden></ul>

  <div class="stack">
    <h3>Photos <span class="cnt-inline" id="photoCount"></span></h3>
    {
      /* The texture photograph (owner, 2026-09-20): one of these photos is the close-up of the weave,
         and the buyer's product popup shows it where the marker chips used to be. A radio per tile,
         so choosing one un-chooses the last — a rug has exactly one texture — with "No texture photo"
         below as the way to take the choice back. rug-form.ts reads the checked radio on save; on the
         ADD form the value is the supplier URL, which it swaps for the Drive id the import returns. */
    }
    <p class="hint">Tick the close-up of the weave: the customer sees it in the product popup.</p>
    <div id="photoStrip" class="grid photos">
      {
        rug?.photos.map((id, i) => (
          <label class="card tile">
            <div class="ph">
              <img src={driveImageUrl(id, 800)} alt="" loading="lazy" />
            </div>
            <div class="mt">
              <input
                type="radio"
                name="texture"
                data-texture
                value={id}
                checked={rug?.textureId === id}
                aria-label={`Photo ${i + 1} is the texture photo`}
              />
              texture · {i + 1}
            </div>
          </label>
        ))
      }
    </div>
    <label class="chk" id="textureNone">
      <input type="radio" name="texture" data-texture value="" checked={!rug?.textureId} />
      No texture photo
    </label>
    <p class="hint" id="photoHint" hidden>
      Photo storage is not connected, so photos cannot be uploaded. Paste Google Drive links below instead.
    </p>
    <div class="f wide">
      <label for="f_photos">Photo links (Google Drive) — one per line; the first is the card image</label>
      <textarea id="f_photos" rows="3">{rug?.photos.join('\n') ?? ''}</textarea>
    </div>
  </div>

  <div class="actions">
    {
      !edit && (
        <label class="chk">
          <input
            type="checkbox"
            id="savePhotos"
            checked={driveScopeOk === true}
            disabled={driveScopeOk !== true}
          />
          Save photos to Google Drive
        </label>
      )
    }
    <label class="chk">
      <input type="checkbox" id="roundOnSave" checked={!edit} />
      Round price to {roundStep} on save
    </label>
    {
      !edit && (
        <div class="actions__bar">
          {/* "Cancel", not "Clear" (owner, 2026-09-18): after a scrape this form IS the preview of
              what was fetched, so the secondary action is backing out of it, not tidying a field.
              Pinned to the bottom, Cancel left and Save right (owner, 2026-09-18), so the save is
              reachable without scrolling past every field. */}
          <button class="btn btn--secondary" id="btnClear" type="button">
            Cancel
          </button>
          <button class="btn btn--primary" id="btnAdd" type="button">
            Save product
          </button>
        </div>
      )
    }
    {
      edit && (
        <>
          <button class="btn btn--primary" id="btnSave" type="button">
            Save
          </button>
          {/* Owner, 2026-09-18. The endpoint existed from the start and nothing ever called it, so
              there was no way to remove a product from the admin at all. It is a HARD delete — the
              row, and the photos in Drive, permanently — which is why it confirms twice over: the
              shared dialog below, with the product named in it. */}
          <button class="btn btn--destructive" id="btnDelete" type="button">
            Delete product
          </button>
        </>
      )
    }
  </div>
  <div id="m2" class="msg"></div>
  <input type="hidden" id="f_version" value={rug?.version ?? ''} />
  {edit && rug && <p class="hint mono">{metaLine}</p>}
</div>

{
  edit && (
    <dialog id="confirm">
      <p id="confirmText" />
      <div class="actions">
        {/* Neutral by default on purpose. This dialog is shared by Archive and Restore, and
            confirmStatus() in rug-form.ts swaps this to btn--destructive for the archive path only —
            so a Restore prompt never renders its affirmative button in warning red. */}
        <button class="btn btn--primary" id="confirmYes" type="button">
          Yes
        </button>
        <button class="btn btn--secondary" id="confirmNo" type="button">
          Cancel
        </button>
      </div>
    </dialog>
  )
}

<style is:global>
  [hidden] {
    display: none !important;
  }
  .tagrow {
    align-items: flex-start;
    margin-top: var(--stack-sm);
  }
  .tagrow .chips {
    margin-top: 0;
    flex: 1;
  }
  .newtag {
    display: flex;
    gap: var(--stack-sm);
    align-items: center;
  }
  .newtag input {
    width: 160px;
  }
  .pair {
    display: flex;
    gap: var(--stack-sm);
    align-items: stretch;
  }
  .pair .chip {
    white-space: nowrap;
  }
  .warnings {
    padding-left: var(--stack-lg);
    margin: var(--stack-sm) 0 0;
  }
  .photos {
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: var(--stack-md);
    margin-top: var(--stack-md);
  }
  .photos .tile .ph {
    aspect-ratio: 3 / 4;
  }
  .photos .tile .mt {
    word-break: break-all;
  }
  .photos label.tile {
    cursor: pointer;
  }
  .photos .tile input {
    width: auto;
  }
  .cnt-inline {
    color: var(--accent);
  }
  a.chip {
    text-decoration: none;
    display: inline-block;
  }
  a.chip[aria-disabled='true'] {
    opacity: 0.45;
    pointer-events: none;
  }
</style>
