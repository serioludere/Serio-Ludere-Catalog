---
// Inline Row — Figma set 78:325, as used on P2 (79:1461…79:1530).
//
// "A products row that edits in place. Click a cell, it becomes an input; Enter commits, Esc
// reverts, Tab moves on. Saving dims the row rather than replacing it with a spinner."
//
// Columns match the P2 header exactly: ID 110 · Title 280 · Collection 150 · Size 140 · Price 130,
// then a flexible spacer, then the action slot. The read state is server-rendered; the editing,
// saving and error states are applied by src/scripts/admin/inline-row.ts, which is what keeps the
// row in place throughout — the thing the footnote on P2 is careful to promise.
//
// NOT used on mobile: "inline table editing on a phone is a trap. Mobile uses cards, and editing
// opens the same drawer." The table is hidden below 768 in admin.css.
//
// Filtering reuses the same data-* contract as RugCardAdmin so one filter drives both views.
import type { AdminRug } from '../../lib/admin/read.ts';
import { dims } from '../../lib/units.ts';
import { collectionSlug, collectionSlugs } from '../../lib/text.ts';
import type { Collection } from '../../lib/sheets/types.ts';

interface Props {
  rug: AdminRug;
  collections: readonly Collection[];
  /** Distinct customers currently liking the rug; 0 renders as a dash. */
  likes?: number;
}
const { rug, collections, likes = 0 } = Astro.props;

const slug = rug.collection.trim() ? collectionSlug(rug.collection, collections) : '';
// Every slug the rug belongs to, so one chip filter drives cards and rows alike.
const slugs = rug.collections.length ? collectionSlugs(rug.collections, collections).join(' ') : '';
const size = dims(rug.widthCm, rug.lengthCm, 'cm');
const price = rug.priceUsd ? `$${rug.priceUsd.toLocaleString('en-US')}` : '';
// Figma's "All sources" dropdown, delivered without a control: `supplier` is a two-value enum
// (dto.ts), so a 180px select for two options is furniture — typing "karavan" is faster, and it also
// matches the supplier's own reference. A haystack, never markup.
const search = [rug.name, rug.id, rug.supplierRef, rug.slug, rug.supplier]
  .join(' ')
  .toLowerCase()
  .replace(/[<>]/g, ' ');
---

{
  /* RugTable declares role="table", but this row carried no role at all — so the catalogue was
    exposed as a table holding one header row and no data, whether it contains four products or four
    hundred, and table navigation was dead. The row role goes on `.irow` rather than on `.irow__line`
    because `.irow` is the table's direct descendant; `.irow__line` is pure layout and says so, which
    leaves the cells owned by the row. `.irow__spacer` is presentational in both head and row, so the
    column count matches at six. */
}
<div
  class="irow"
  role="row"
  data-card
  data-row
  data-id={rug.id}
  data-collection={slug}
  data-collections={slugs}
  data-status={rug.status}
  data-attention={rug.commitStatus === 'pending' ? 'photos' : ''}
  data-search={search}
>
  <div class="irow__line" role="presentation">
    <span class="irow__id" role="cell">{rug.id}</span>
    <span class="irow__title" role="cell" data-cell="name">{rug.name}</span>
    <span class="irow__collection" role="cell">{rug.collection}</span>
    <span class="irow__size" role="cell">{size}</span>
    <span class="irow__price" role="cell">{price}</span>
    <span class="irow__likes" role="cell">{likes > 0 ? likes : '—'}</span>
    <span class="irow__spacer" role="presentation"></span>
    <span class="irow__action" role="cell">
      {
        /* Brief §12: a row whose photo import did not finish says so, and the list offers to finish
           it. RugCardAdmin has rendered this since it shipped; the ROW did not — and the row is the
           DEFAULT view (view-switch.ts rests on 'list'), so the only route to a half-imported rug
           was to switch to cards and scroll the catalogue hunting for badges. `retryPhotos()` in
           rug-list.ts is bound by delegation, so this needs no new script. */
        rug.commitStatus === 'pending' && (
          <button type="button" class="chip retry" data-retry={rug.id}>
            Finish photo import
          </button>
        )
      }
      <a href={`/admin/rugs/${encodeURIComponent(rug.id)}`}>Open</a>
      <button type="button" data-edit={rug.id}>Edit</button>
    </span>
  </div>
  {
    /* Per-row status. A row may own only cells, so it is one. No `aria-colspan`: an earlier pass set
      it to 6, but with no aria-colindex to anchor it this cell is implicitly column 7, so the span
      read as columns 7-12 — off the end of a six-column table. A plain trailing cell is ragged but
      valid; a span pointing past the table is not. It carries its own live region because the
      page-level banner sits nowhere near the row whose save just failed. */
  }
  <p class="irow__message" role="cell" aria-live="polite" hidden></p>
</div>
