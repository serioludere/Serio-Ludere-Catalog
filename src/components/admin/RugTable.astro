---
// The Products table — Figma P2 79:1439, header row 79:1441 plus six Inline Rows.
//
// The header carries a 1px bottom border in border/strong (heavier than the row hairlines, so the
// head reads as a head) and the Label style at 12px muted. Column widths are shared with the rows
// through .irow__* so the two can never drift apart.
//
// It is a plain <div> stack rather than a <table>: every row is an editable form surface with a
// trailing action, and a real <table> would fight that on every cell. The header is marked up as a
// row of column headers so the structure still reads.
import type { AdminRug } from '../../lib/admin/read.ts';
import type { Collection } from '../../lib/sheets/types.ts';
import RugRow from './RugRow.astro';

interface Props {
  rugs: readonly AdminRug[];
  collections: readonly Collection[];
  /** Product id → distinct customers currently liking it (src/lib/admin/likes.ts). */
  likesById?: Map<string, number>;
}
const { rugs, collections, likesById } = Astro.props;
---

<div class="rugtable" role="table" aria-label="Products">
  <div class="rugtable__head" role="row">
    <span class="irow__id" role="columnheader">ID</span>
    <span class="irow__title" role="columnheader">Title</span>
    <span class="irow__collection" role="columnheader">Collection</span>
    <span class="irow__size" role="columnheader">Size</span>
    <span class="irow__price" role="columnheader">Price</span>
    <span class="irow__likes" role="columnheader">Likes</span>
    <span class="irow__shopify" role="columnheader">Shopify</span>
    <span class="irow__source" role="columnheader">Source</span>
    {
      /* A role="row" may own only cells, and these two were plain spans — the same defect the body
        rows had. The spacer is pure layout so it says so; the action column is a real column and
        needs a name, which is visually hidden because the header cell is drawn empty. Head and body
        now agree at nine columns (Shopify and Source joined on 2026-09-25). */
    }
    <span class="irow__spacer" role="presentation"></span>
    <span class="irow__action" role="columnheader"><span class="sr-only">Actions</span></span>
  </div>
  {rugs.map((rug) => <RugRow rug={rug} collections={collections} likes={likesById?.get(rug.id) ?? 0} />)}
</div>
