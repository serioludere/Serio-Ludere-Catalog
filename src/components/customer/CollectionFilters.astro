---
// The filter strip, by collection only (owner, 2026-09-17: buyers never filter by tag).
//
// One tab per collection that has rugs, in the studio's order, then "All". Text tabs, not
// buttons (owner, 2026-09-17, replacing the earlier bordered chip): a plain label with a hairline
// underneath, active = bold with a thicker underline. The underline is a box-shadow, not a border —
// the same trick .pv-input:focus-visible uses (preview.css) — so the 1px → 3px change on activation
// never shifts the row's height.
//
// This strip now shares its row with the unit/currency controls (owner, 2026-09-17): "The
// collection" heading it used to sit under is gone, which is what freed the space.
//
// The row wraps at every width (owner, 2026-09-23). A phone used to scroll it sideways with the last
// tab cut at the frame edge as the only hint, and buyers never guessed there were more tabs to slide
// to — every collection is now on screen, on a second line where it needs one.
//
// "All" comes LAST, after the collections (owner, 2026-09-25), and the page opens on the first
// collection rather than on everything: the buyer meets one collection at a time and reaches for
// "All" when they want the whole wall. Which tab starts pressed is the page's decision (`active`),
// because a `?collection=` link can name any of them.
//
// On a phone the strip folds into one dropdown while the buyer scrolls (owner, 2026-10-08: the
// tabs pinned under the header were distracting). The dropdown is rendered here with the tabs, so
// both are one list in one order. It is hidden until the page's sticky bar pins it in place
// (src/pages/[slug]/index.astro).
//
// Its menu is drawn in the catalogue's own style (owner, 2026-10-09: the phone's native list looked
// bare and unstyled). It follows the picker Open state the design file draws (docs/ADR.md D18): a
// bordered panel of rows, the current one marked with a 16px check. The face is a button and every
// row is a button, so Tab, Enter, Space and a screen reader work as they do anywhere.
// scripts/customer/collection-menu.ts opens and closes it.
interface Props {
  collections: Array<{ slug: string; name: string; count: number; description?: string }>;
  /** The tab pressed on first paint: a collection slug, or 'all'. */
  active: string;
}
const { collections, active } = Astro.props;
const activeName = collections.find((c) => c.slug === active)?.name ?? 'All';
---

{
  /* Each tab carries its own description; filters.ts moves the pressed one into the intro line the
    page renders under this strip (owner, 2026-09-18). "All" has none — it is not a collection. */
}
<nav class="pv-filters" aria-label="Filter by collection">
  {
    collections.map((c) => (
      <button
        type="button"
        class:list={['pv-chip', { 'is-on': c.slug === active }]}
        data-filter={c.slug}
        data-description={c.description || undefined}
        aria-pressed={c.slug === active ? 'true' : 'false'}
      >
        {c.name}
      </button>
    ))
  }
  <button
    type="button"
    class:list={['pv-chip', { 'is-on': active === 'all' }]}
    data-filter="all"
    aria-pressed={active === 'all' ? 'true' : 'false'}
  >
    All
  </button>
  {
    /* The face names the chosen collection and opens the menu under it. filters.ts keeps both in
      step with the tabs: the face's name, and `aria-current` on the row on screen. */
  }
  <div class="pv-picker" data-collection-picker>
    <button
      type="button"
      class="pv-picker-box"
      data-picker-toggle
      aria-expanded="false"
      aria-controls="pvPickerMenu"
    >
      <span class="sr-only">Collection:</span>
      <span class="pv-picker-name" data-picker-name>{activeName}</span>
      <svg
        class="pv-picker-chevron"
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 6.5L8 10.5L12 6.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
    </button>
    <div class="pv-picker-scrim" data-picker-scrim hidden></div>
    <ul class="pv-picker-menu" id="pvPickerMenu" data-picker-menu hidden>
      {
        [...collections, { slug: 'all', name: 'All' }].map((c) => (
          <li>
            <button
              type="button"
              class="pv-picker-option"
              data-pick={c.slug}
              aria-current={c.slug === active ? 'true' : undefined}
            >
              <span>{c.name}</span>
              <svg
                viewBox="0 0 16 16"
                width="16"
                height="16"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M3.5 8.5L6.5 11.5L12.5 4.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .pv-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--stack-xl);
  }

  .pv-chip {
    display: inline-flex;
    align-items: center;
    padding-block: var(--stack-sm);
    border: 0;
    background: none;
    /* The rest tab's line: an inset shadow, not a border, so activating a tab (below) never adds to
       the box's height and shifts the row. */
    box-shadow: inset 0 -1px 0 0 var(--rule);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--leading-body);
    white-space: nowrap;
    cursor: pointer;
    transition:
      box-shadow var(--motion-quick) var(--motion-ease),
      color var(--motion-quick) var(--motion-ease);
  }
  .pv-chip:hover {
    color: var(--ink);
  }

  .pv-chip.is-on,
  .pv-chip[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 0 var(--ink);
  }

  @media (max-width: 767px) {
    .pv-filters {
      /* Claims the whole row inside .pv-title-row (src/pages/[slug]/index.astro); the unit/currency
         controls live in the header on a phone. The lines sit closer than the tabs do across, and
         every line is centred (owner, 2026-09-25) — a ragged left edge with a short second line read
         as a row that had run out, not as a set of tabs. */
      flex: 1 1 100%;
      justify-content: center;
      column-gap: var(--stack-lg);
      row-gap: var(--stack-sm);
    }
    .pv-chip {
      flex: none;
    }
  }

  /* The dropdown (owner, 2026-10-08). Nothing until the page's bar shows it on a phone. The face is
     the pressed tab's own type, bold ink at the tab size, with the currency picker's 12px chevron
     after it. The chevron turns over while the menu is open. */
  .pv-picker {
    display: none;
    align-items: center;
    justify-content: center;
  }
  .pv-picker-box {
    display: inline-flex;
    align-items: center;
    gap: var(--stack-xs);
    max-width: 100%;
    padding: var(--stack-sm) var(--stack-md);
    border: 0;
    background: none;
    color: var(--ink);
    font-family: inherit;
    cursor: pointer;
  }
  .pv-picker-name {
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pv-picker-chevron {
    flex: none;
    width: 12px;
    height: 12px;
    transition: transform var(--motion-quick) var(--motion-ease);
  }
  .pv-picker-box[aria-expanded='true'] .pv-picker-chevron {
    transform: rotate(180deg);
  }

  /* While the menu is open, the page under the band dims, with the same overlay as behind the rug
     popup. A tap on it closes the menu and goes no further, so it never opens the rug under the
     finger. The band and the header above it stay clear. */
  .pv-picker-scrim {
    position: fixed;
    inset: calc(var(--pv-header-h, 53px) + var(--pv-picker-h, 44px)) 0 0;
    z-index: 1;
    background: var(--bg-overlay);
    animation: pv-picker-fade var(--motion-quick) var(--motion-ease);
  }

  /* The menu: the catalogue's bordered box on the surface, square like every control here, hanging
     from the band and centred under the face. The drawn picker's 40px rows are 44 here, a thumb's
     width. A hairline sits between rows, as under the tabs. The collection on screen is bold ink
     with the 16px check; the rest are in the tabs' softer ink. A long list scrolls inside the box,
     never the page behind it. */
  .pv-picker-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 2;
    width: max-content;
    min-width: 14rem;
    max-width: calc(100vw - 2 * var(--gutter));
    max-height: calc(100dvh - var(--pv-header-h, 53px) - var(--pv-picker-h, 44px) - var(--gutter));
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
    border: var(--rule-width) solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface);
    transform: translateX(-50%);
    animation: pv-picker-drop var(--motion-quick) var(--motion-ease);
  }
  .pv-picker-menu li + li {
    border-top: var(--rule-width) solid var(--rule);
  }
  .pv-picker-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--stack-lg);
    width: 100%;
    min-height: 44px;
    padding: 0 var(--stack-lg);
    border: 0;
    background: none;
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--leading-body);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }
  .pv-picker-option:hover {
    background: var(--subtle);
    color: var(--ink);
  }
  /* Inside the box, so its overflow does not cut the ring off. */
  .pv-picker-option:focus-visible {
    outline-offset: calc(-1 * var(--focus-offset) - 1px);
  }
  .pv-picker-option[aria-current='true'] {
    color: var(--ink);
    font-weight: 700;
  }
  .pv-picker-option svg {
    flex: none;
    width: 16px;
    height: 16px;
    visibility: hidden;
  }
  .pv-picker-option[aria-current='true'] svg {
    visibility: visible;
  }

  @keyframes pv-picker-drop {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-1 * var(--stack-xs)));
    }
  }
  @keyframes pv-picker-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import { initFilters } from '../../scripts/filters.ts';
  initFilters();
</script>
