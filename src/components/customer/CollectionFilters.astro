---
// The filter strip, by collection only (owner, 2026-09-17: buyers never filter by tag).
//
// One tab per collection that has rugs, in the studio's order, then "All". Text tabs, not
// buttons (owner, 2026-09-17, replacing the earlier bordered chip): a plain label with a hairline
// underneath, active = bold with a thicker underline. The underline is a box-shadow, not a border —
// the same trick .pv-input:focus-visible uses (preview.css) — so the 1px → 3px change on activation
// never shifts the row's height.
//
// This strip now shares its row with the unit/currency controls (owner, 2026-09-17): "The
// collection" heading it used to sit under is gone, which is what freed the space.
//
// The row wraps at every width (owner, 2026-09-23). A phone used to scroll it sideways with the last
// tab cut at the frame edge as the only hint, and buyers never guessed there were more tabs to slide
// to — every collection is now on screen, on a second line where it needs one.
//
// "All" comes LAST, after the collections (owner, 2026-09-25), and the page opens on the first
// collection rather than on everything: the buyer meets one collection at a time and reaches for
// "All" when they want the whole wall. Which tab starts pressed is the page's decision (`active`),
// because a `?collection=` link can name any of them.
//
// On a phone the strip folds into one dropdown while the buyer scrolls (owner, 2026-10-08: the
// tabs pinned under the header were distracting). The dropdown is rendered here with the tabs, so
// both are one list in one order. It is hidden until the page's sticky bar pins it in place
// (src/pages/[slug]/index.astro). It is a native <select> under a drawn face, for the reasons the
// currency picker gives in PreviewControls.astro: the phone's own picker, keyboard and screen
// reader all work without being rebuilt by hand.
interface Props {
  collections: Array<{ slug: string; name: string; count: number; description?: string }>;
  /** The tab pressed on first paint: a collection slug, or 'all'. */
  active: string;
}
const { collections, active } = Astro.props;
const activeName = collections.find((c) => c.slug === active)?.name ?? 'All';
---

{
  /* Each tab carries its own description; filters.ts moves the pressed one into the intro line the
    page renders under this strip (owner, 2026-09-18). "All" has none — it is not a collection. */
}
<nav class="pv-filters" aria-label="Filter by collection">
  {
    collections.map((c) => (
      <button
        type="button"
        class:list={['pv-chip', { 'is-on': c.slug === active }]}
        data-filter={c.slug}
        data-description={c.description || undefined}
        aria-pressed={c.slug === active ? 'true' : 'false'}
      >
        {c.name}
      </button>
    ))
  }
  <button
    type="button"
    class:list={['pv-chip', { 'is-on': active === 'all' }]}
    data-filter="all"
    aria-pressed={active === 'all' ? 'true' : 'false'}
  >
    All
  </button>
  {
    /* The face shows the chosen collection; the transparent select over it takes the tap and opens
      the phone's own list. filters.ts keeps both in step with the tabs. */
  }
  <div class="pv-picker" data-collection-picker>
    <div class="pv-picker-box">
      <span class="pv-picker-name" data-picker-name aria-hidden="true">{activeName}</span>
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 6.5L8 10.5L12 6.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <select class="pv-picker-select" data-collection-select aria-label="Collection">
        {
          collections.map((c) => (
            <option value={c.slug} selected={c.slug === active}>
              {c.name}
            </option>
          ))
        }
        <option value="all" selected={active === 'all'}> All </option>
      </select>
    </div>
  </div>
</nav>

<style>
  .pv-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--stack-xl);
  }

  .pv-chip {
    display: inline-flex;
    align-items: center;
    padding-block: var(--stack-sm);
    border: 0;
    background: none;
    /* The rest tab's line: an inset shadow, not a border, so activating a tab (below) never adds to
       the box's height and shifts the row. */
    box-shadow: inset 0 -1px 0 0 var(--rule);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--leading-body);
    white-space: nowrap;
    cursor: pointer;
    transition:
      box-shadow var(--motion-quick) var(--motion-ease),
      color var(--motion-quick) var(--motion-ease);
  }
  .pv-chip:hover {
    color: var(--ink);
  }

  .pv-chip.is-on,
  .pv-chip[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 0 var(--ink);
  }

  @media (max-width: 767px) {
    .pv-filters {
      /* Claims the whole row inside .pv-title-row (src/pages/[slug]/index.astro); the unit/currency
         controls live in the header on a phone. The lines sit closer than the tabs do across, and
         every line is centred (owner, 2026-09-25) — a ragged left edge with a short second line read
         as a row that had run out, not as a set of tabs. */
      flex: 1 1 100%;
      justify-content: center;
      column-gap: var(--stack-lg);
      row-gap: var(--stack-sm);
    }
    .pv-chip {
      flex: none;
    }
  }

  /* The dropdown (owner, 2026-10-08). Nothing until the page's bar shows it on a phone. The face is
     the pressed tab's own type, bold ink at the tab size, with the currency picker's 12px chevron
     after it. */
  .pv-picker {
    display: none;
    align-items: center;
    justify-content: center;
  }
  .pv-picker-box {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--stack-xs);
    max-width: 100%;
    padding: var(--stack-sm) var(--stack-md);
    color: var(--ink);
  }
  .pv-picker-name {
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pv-picker-box svg {
    flex: none;
    width: 12px;
    height: 12px;
  }
  /* Laid over the whole face and invisible, so the tap lands on the real control. 16px so iOS does
     not zoom the page when it is focused, the same reason the search field is 16px. */
  .pv-picker-select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    appearance: none;
    -webkit-appearance: none;
    font-size: 16px;
    cursor: pointer;
  }
  /* The select's own ring would be invisible with it, so the face carries the ring. */
  .pv-picker-box:has(:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
</style>

<script>
  import { initFilters } from '../../scripts/filters.ts';
  initFilters();
</script>
