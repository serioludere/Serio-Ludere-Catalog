---
// Unit toggle + currency picker (Figma "Unit Toggle" 130:260, "Currency Picker" 130:265).
//
// The behaviour already exists in src/scripts/prefs.ts: it finds every `#unitTog` / `[data-unit-toggle]`
// and `#cur` / `select[data-cur]`, remembers the choice, and re-renders every `[data-dims]` and
// `[data-price]` on the page. Only the appearance is new — a bordered segmented control where the
// active half is filled with ink, and a bordered select with its own chevron.
//
// `data-sep="·"` on the dimension lines is what makes the preview render "240 · 170 cm" while the
// public catalogue keeps the reference's cross; prefs.ts and the pre-paint step both honour it.
//
// **Deliberate deviation.** The design draws an Open state for the picker: a 74px bordered panel of
// 40px rows, each a currency code beside its symbol in the muted grey, with a 16px check against the
// current one. This uses a native `<select>` instead, so the closed trigger matches the design and
// the open menu is the platform's. The trade is worth making: a native select brings correct
// keyboard handling, the iOS and Android pickers, and screen-reader support that a hand-built
// `role="listbox"` would have to re-earn — and the open menu is a transient OS surface nobody
// compares against a frame. Building the drawn panel is a contained change if the studio wants it.
import { SUPPORTED_CURRENCIES, type RateTable } from '../../lib/currency.ts';

interface Props {
  rates: RateTable;
  /**
   * Offer the sort control (owner, 2026-09-13: sort by like count). Only the grid can be sorted, so
   * the detail page renders the same control strip without it rather than showing a dead select.
   */
  sort?: boolean;
  /**
   * `header`: the copy the catalog puts beside the wordmark on a phone (owner, 2026-09-23), shown
   * only below 768. It carries no ids — the page copy keeps `#unitTog` / `#cur` — and prefs.ts finds
   * both copies by their data attributes and keeps them in step. Never offers sort.
   */
  placement?: 'page' | 'header';
  /**
   * Offer the name search (owner, 2026-09-30): a magnifier left of the unit toggle that opens into
   * a field. Only the grid has rugs to search, so the detail page leaves it out. Both copies carry
   * it; src/scripts/customer/search.ts keeps them in step.
   */
  search?: boolean;
}
const { rates, sort = false, placement = 'page', search = false } = Astro.props;
const page = placement === 'page';
const searchId = page ? 'pvSearch' : 'pvSearchHeader';
const fromSheet = Object.keys(rates.rates).filter((c) => c in rates.symbols);
const currencies = fromSheet.length
  ? ['USD', ...fromSheet.filter((c) => c !== 'USD')]
  : [...SUPPORTED_CURRENCIES];
---

<div class:list={['pv-controls', { 'pv-controls--header': !page }]}>
  {
    search && (
      <div class="pv-search" data-search role="search">
        {/* The magnifier is the control's only face until pressed; open, it closes the search. */}
        <button
          type="button"
          class="pv-search-toggle"
          data-search-toggle
          aria-expanded="false"
          aria-controls={searchId}
          aria-label="Search by name"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
            <circle cx="7" cy="7" r="4.75" stroke="currentColor" stroke-width="1.5" />
            <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
        <input
          id={searchId}
          class="pv-search-input"
          type="search"
          data-search-input
          placeholder="Search by name"
          aria-label="Search rugs by name"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          maxlength="80"
          tabindex="-1"
        />
        <button type="button" class="pv-search-clear" data-search-clear aria-label="Clear search" hidden>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
            <path
              d="M4.5 4.5L11.5 11.5M11.5 4.5L4.5 11.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    )
  }
  <div class="pv-seg" id={page ? 'unitTog' : undefined} data-unit-toggle role="group" aria-label="Units">
    <button type="button" data-u="cm" class="on" aria-pressed="true">cm</button>
    <button type="button" data-u="ft" aria-pressed="false">ft</button>
  </div>
  {
    sort && page && (
      <div class="pv-select">
        {/* Native <select> for the same reason the currency picker is one: the platform's keyboard
            handling, mobile pickers and screen-reader support are not worth re-earning by hand. */}
        <select id="sortBy" aria-label="Sort rugs">
          <option value="featured">Featured</option>
          <option value="liked">Most liked</option>
        </select>
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
          <path
            d="M4 6.5L8 10.5L12 6.5"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    )
  }
  <div class="pv-select">
    <select id={page ? 'cur' : undefined} data-cur aria-label="Currency">
      {currencies.map((c) => <option>{c}</option>)}
    </select>
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 6.5L8 10.5L12 6.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
      ></path>
    </svg>
  </div>
</div>

<style>
  .pv-controls {
    display: flex;
    align-items: center;
    gap: var(--stack-md);
  }

  .pv-seg {
    display: inline-flex;
    height: 36px;
    /* --border-control, not --rule: these are pressable edges, so WCAG 1.4.11's 3:1 applies. */
    border: var(--rule-width) solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .pv-seg button {
    padding-inline: var(--stack-md);
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
    text-transform: none;
    /* Tracking 0, not an optical bump: the Label style (Inter 700 / 12 / uppercase) is drawn with
       letter-spacing 0 on every run in this file, and the Unit Toggle's own segments in 130:260
       carry none. Declared rather than omitted so it reads as the Figma value, and so it visibly
       agrees with .pv-select select below and .pv-label / .pv-btn in preview.css. */
    letter-spacing: 0;
    color: var(--ink-soft);
    cursor: pointer;
    /* No transition, deliberately: the Unit Toggle documentation says switching is instant and every
       dimension on the surface reconverts at the same moment. Animating the segment would put motion
       between a question and its answer. Declared, not merely absent, so nobody "fixes" it later. */
    transition: none;
  }
  .pv-seg button.on,
  .pv-seg button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--surface);
  }

  /* Symmetric 12px inline padding with an 8px gap to the 16px chevron, as drawn. The height is a
     minimum rather than a fixed 36 so a larger text setting is not clipped. */
  .pv-select {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    border: var(--rule-width) solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .pv-select select {
    appearance: none;
    -webkit-appearance: none;
    align-self: stretch;
    padding-left: var(--stack-md);
    padding-right: calc(var(--stack-md) + var(--stack-sm) + 16px);
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-body);
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
    cursor: pointer;
  }
  .pv-select svg {
    position: absolute;
    right: var(--stack-md);
    width: 16px;
    height: 16px;
    color: var(--ink);
    pointer-events: none;
  }

  /* The name search (owner, 2026-09-30). Closed it is a 36px square in the same bordered box as the
     unit toggle beside it, holding only the magnifier; open, the field slides out of it to the right,
     so the magnifier stays where the buyer pressed it and the controls after it are pushed along. */
  .pv-search {
    display: inline-flex;
    /* Never squeezed: on a narrow row it is the tabs' strip that gives way (it wraps), not a field
       the buyer is typing into. */
    flex: none;
    align-items: center;
    height: 36px;
    border: var(--rule-width) solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .pv-search-toggle,
  .pv-search-clear {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .pv-search-toggle:hover,
  .pv-search-clear:hover {
    color: var(--brand);
  }
  .pv-search-clear[hidden] {
    display: none;
  }
  /* Folded away, the field is zero wide AND invisible, so it is neither seen nor reachable; the
     visibility waits for the width to finish closing, and comes back at once on opening. */
  .pv-search-input {
    width: 0;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--ink);
    visibility: hidden;
    transition:
      width var(--motion-quick) var(--motion-ease),
      visibility 0s linear var(--motion-quick);
  }
  .pv-search.is-open .pv-search-input {
    width: 11rem;
    padding-right: var(--stack-sm);
    visibility: visible;
    transition:
      width var(--motion-quick) var(--motion-ease),
      visibility 0s;
  }
  .pv-search-input::placeholder {
    color: var(--ink-soft);
    opacity: 1;
  }
  /* type=search brings its own clear cross in WebKit and Blink but not Firefox; ours is drawn the same
     everywhere, so the native one is removed rather than shown twice. */
  .pv-search-input::-webkit-search-cancel-button,
  .pv-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
  /* One focus ring round the whole box, not one on the field inside its own border. */
  .pv-search:has(:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .pv-search :focus-visible {
    outline: none;
  }

  /* The phone header's copy: a desktop has the page copy beside the tabs, so this one waits. */
  .pv-controls--header {
    display: none;
  }

  @media (max-width: 767px) {
    /* Wraps for the same reason the title row does: three controls no longer fit the 358px the
       two-control frame was measured against, and a select cannot shrink below its own label. */
    .pv-controls {
      gap: var(--stack-sm);
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .pv-controls--header {
      display: flex;
      flex-wrap: nowrap;
    }
    /* Smaller on a phone (owner, 2026-09-25): at 36px with 12px bold labels the two controls read as
       the loudest thing on the wordmark's row. 28 tall, 11px labels, tighter padding and a 12px
       chevron — still clear of WCAG 2.5.8's 24px minimum target. */
    .pv-seg {
      height: 28px;
    }
    .pv-seg button {
      padding-inline: var(--stack-sm);
      font-size: var(--text-xs);
    }
    .pv-select {
      min-height: 28px;
    }
    .pv-select select {
      padding-left: var(--stack-sm);
      padding-right: calc(var(--stack-sm) + var(--stack-xs) + 12px);
      font-size: var(--text-xs);
    }
    .pv-select svg {
      right: var(--stack-sm);
      width: 12px;
      height: 12px;
    }
    .pv-search {
      height: 28px;
    }
    .pv-search-toggle,
    .pv-search-clear {
      width: 28px;
    }
    .pv-search svg {
      width: 14px;
      height: 14px;
    }
    /* 16px, not the 11px of the labels beside it: iOS zooms the whole page into any field set
       smaller than 16px the moment it is focused, and does not zoom back out. */
    .pv-search-input {
      font-size: 16px;
    }
    /* There is no room beside the wordmark for a field, so on the phone header the open search lies
       over the whole row, gutter to gutter, in the row's own place. The unit and currency controls
       under it come back when it closes. */
    .pv-controls--header .pv-search.is-open {
      position: absolute;
      z-index: 2;
      inset-inline: var(--gutter);
    }
    .pv-controls--header .pv-search.is-open .pv-search-input {
      flex: 1 1 auto;
      width: auto;
    }
  }
</style>

<script>
  import { initPrefs } from '../../scripts/prefs.ts';
  initPrefs();
</script>

<script>
  import { initSort } from '../../scripts/customer/sort.ts';
  initSort();
</script>

<script>
  import { initSearch } from '../../scripts/customer/search.ts';
  initSearch();
</script>
