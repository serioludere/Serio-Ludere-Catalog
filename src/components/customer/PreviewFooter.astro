---
// The preview footer (desktop Figma 130:274 / 130:297; mobile 131:293 / 131:311).
//
// Three groups on one row: the studio's brand mark; every studio channel; and, pushed to the right,
// the payment disclaimer the studio dictates.
//
// Owner, 2026-09-17, replacing the original flat link list (which read as one run-on line — no
// icon, no grouping, and it was the same "cluttered" complaint the CollectionFilters restyle was
// answering):
//   - the wordmark text is now the same black logo mark the header and both logins use (replaced
//     by plain text again on 2026-09-20, with the whole footer centred and its links underlined);
//   - the "Contact" label is gone — the icons now say what the group is;
//   - the channels are three icon-led groups (site + email, both WhatsApp lines, Instagram),
//     each stacked, 48px apart horizontally (--stack-2xl, mode-invariant);
//   - "The rugs you like are shared with Serio Ludere." is gone from the fine print too — it
//     already lived on the gate's own consent note before that was removed, and here it was a
//     second copy nobody asked for.
import {
  STUDIO_EMAIL,
  STUDIO_INSTAGRAM,
  STUDIO_INSTAGRAM_LABEL,
  STUDIO_PHONE_LABEL,
  STUDIO_PHONE_LABEL_2,
  STUDIO_SITE,
  STUDIO_SITE_LABEL,
  STUDIO_WHATSAPP,
  STUDIO_WHATSAPP_2,
} from '../../lib/studio.ts';
---

<footer class="pv-footer">
  <div class="pv-footer-row">
    <div class="pv-footer-brand">
      {
        /* Owner, 2026-09-20: the logo mark is gone here too — the name, set in the brand face, in the
          same capitals the header now uses (see PreviewHeader.astro for why it is typed, not
          text-transform'd). */
      }
      <p class="pv-footer-mark pv-h4">SERIO LUDERE</p>
      <div class="pv-footer-contacts">
        <div class="pv-contact-group">
          <a class="pv-contact" href={STUDIO_SITE} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="6.2" stroke="currentColor"></circle>
              <path d="M1.8 8H14.2" stroke="currentColor"></path>
              <path
                d="M8 1.8C10.2 4.2 10.2 11.8 8 14.2C5.8 11.8 5.8 4.2 8 1.8Z"
                stroke="currentColor"
                stroke-linejoin="round"></path>
            </svg>
            {STUDIO_SITE_LABEL}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="pv-contact" href={`mailto:${STUDIO_EMAIL}`}>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path d="M2.5 4.5H13.5V11.5H2.5V4.5Z" stroke="currentColor" stroke-linejoin="round"></path>
              <path
                d="M2.5 4.5L8 9L13.5 4.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            {STUDIO_EMAIL}
          </a>
        </div>
        <div class="pv-contact-group">
          <a class="pv-contact" href={`https://wa.me/${STUDIO_WHATSAPP}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M8 2C4.7 2 2 4.7 2 8C2 9.2 2.3 10.3 2.9 11.3L2 14L4.8 13.1C5.8 13.6 6.9 13.9 8 13.9C11.3 13.9 14 11.2 14 7.9C14 4.6 11.3 2 8 2Z"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M5.8 5.4C5.9 5.2 6.1 5.1 6.3 5.1H6.7C6.9 5.1 7 5.2 7.1 5.4L7.5 6.4C7.6 6.6 7.5 6.8 7.4 6.9L6.9 7.4C6.8 7.5 6.8 7.6 6.9 7.8C7.3 8.5 7.9 9.1 8.6 9.5C8.7 9.6 8.9 9.6 9 9.5L9.5 9C9.6 8.9 9.8 8.8 10 8.9L11 9.3C11.2 9.4 11.3 9.5 11.3 9.7V10.1C11.3 10.5 10.9 10.9 10.5 10.9C8.2 10.9 5.5 8.3 5.1 6C5.1 5.8 5.1 5.6 5.8 5.4Z"
                fill="currentColor"></path>
            </svg>
            {STUDIO_PHONE_LABEL}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="pv-contact" href={`https://wa.me/${STUDIO_WHATSAPP_2}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path
                d="M8 2C4.7 2 2 4.7 2 8C2 9.2 2.3 10.3 2.9 11.3L2 14L4.8 13.1C5.8 13.6 6.9 13.9 8 13.9C11.3 13.9 14 11.2 14 7.9C14 4.6 11.3 2 8 2Z"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M5.8 5.4C5.9 5.2 6.1 5.1 6.3 5.1H6.7C6.9 5.1 7 5.2 7.1 5.4L7.5 6.4C7.6 6.6 7.5 6.8 7.4 6.9L6.9 7.4C6.8 7.5 6.8 7.6 6.9 7.8C7.3 8.5 7.9 9.1 8.6 9.5C8.7 9.6 8.9 9.6 9 9.5L9.5 9C9.6 8.9 9.8 8.8 10 8.9L11 9.3C11.2 9.4 11.3 9.5 11.3 9.7V10.1C11.3 10.5 10.9 10.9 10.5 10.9C8.2 10.9 5.5 8.3 5.1 6C5.1 5.8 5.1 5.6 5.8 5.4Z"
                fill="currentColor"></path>
            </svg>
            {STUDIO_PHONE_LABEL_2}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
        <div class="pv-contact-group">
          <a class="pv-contact" href={STUDIO_INSTAGRAM} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <rect x="2" y="2" width="12" height="12" rx="3.5" stroke="currentColor"></rect>
              <circle cx="8" cy="8" r="3" stroke="currentColor"></circle>
              <circle cx="11.5" cy="4.5" r="0.75" fill="currentColor"></circle>
            </svg>
            {STUDIO_INSTAGRAM_LABEL}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
    <div class="pv-footer-col pv-footer-fine">
      <p>For some card/transfer payments prices are subject to 16% IVA</p>
    </div>
  </div>
</footer>
