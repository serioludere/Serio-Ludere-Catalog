---
// The preview footer (desktop Figma 130:274 / 130:297; mobile 131:293 / 131:311).
//
// Three groups on one row: the studio wordmark; every studio channel (owner, 2026-09-16: website,
// Instagram and both WhatsApp lines, replacing the brief §7 "no social, no WhatsApp" minimalism for
// this footer); and, pushed to the right, the two lines of fine print. Both fine-print lines are
// required — the payment disclaimer the studio dictates, and the line about reactions being shared
// because a buyer tapping a heart should know the studio sees it. At 390 the row stacks and the fine
// print left-aligns.
import {
  STUDIO_EMAIL,
  STUDIO_INSTAGRAM,
  STUDIO_INSTAGRAM_LABEL,
  STUDIO_NAME,
  STUDIO_PHONE_LABEL,
  STUDIO_PHONE_LABEL_2,
  STUDIO_SITE,
  STUDIO_SITE_LABEL,
  STUDIO_WHATSAPP,
  STUDIO_WHATSAPP_2,
} from '../../lib/studio.ts';
---

<footer class="pv-footer">
  <div class="pv-footer-row">
    <div class="pv-footer-col">
      <p class="pv-h4">{STUDIO_NAME}</p>
    </div>
    <div class="pv-footer-col">
      <p class="pv-label pv-muted">Contact</p>
      <div class="pv-footer-links">
        <a href={STUDIO_SITE} target="_blank" rel="noopener">
          {STUDIO_SITE_LABEL}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a href={STUDIO_INSTAGRAM} target="_blank" rel="noopener">
          {STUDIO_INSTAGRAM_LABEL}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a href={`https://wa.me/${STUDIO_WHATSAPP}`} target="_blank" rel="noopener">
          {STUDIO_PHONE_LABEL}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a href={`https://wa.me/${STUDIO_WHATSAPP_2}`} target="_blank" rel="noopener">
          {STUDIO_PHONE_LABEL_2}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <a href={`mailto:${STUDIO_EMAIL}`}>{STUDIO_EMAIL}</a>
      </div>
    </div>
    <div class="pv-footer-col pv-footer-fine">
      <p>For some card/transfer payments prices are subject to 16% IVA</p>
      <p>The rugs you like are shared with {STUDIO_NAME}.</p>
    </div>
  </div>
</footer>
