---
// The private preview's document shell (Figma "05 · Customer Preview").
//
// Deliberately separate from src/components/Layout.astro: that one is the public catalogue's shell
// and carries catalogue.css, which is the byte-for-byte parity record of the original page. The
// preview is a different product with its own design, so it gets its own shell and its own
// stylesheet, and neither can drift into the other.
//
// The link-preview (Open Graph) card lives here rather than on the gate component, because a link
// into the realm can be pasted at any depth and every one of them resolves to the gate for a
// visitor with no session. Its copy is src/lib/customer/share.ts.
//
// Shared with the public shell: the pre-paint step (the visitor's saved reactions and their
// unit/currency choice are correct before first paint) and the rates JSON block that drives it. The
// pre-paint script is the one inline script the hash-based CSP allows; its hash is registered in
// astro.config.mjs and recomputed from the file at build.
import '../../styles/tokens.css';
import '../../styles/modes.css';
import '../../styles/controls.css';
import '../../styles/components.css';
import '../../styles/motion-spec.css';
import '../../styles/preview.css';
import prepaint from '../../scripts/prepaint.js?raw';
import type { RateTable } from '../../lib/currency.ts';
import { SHARE_DESCRIPTION, SHARE_SITE_NAME, SHARE_TITLE } from '../../lib/customer/share.ts';
import { jsonForScript } from '../../lib/view.ts';

interface Props {
  title: string;
  rates: RateTable;
  /** The signed-in customer slug; published so a reaction batch can name its realm. */
  customer?: string;
  /** 'preview-dark' only for the signed-out gate (owner, 2026-09-17); the catalogue itself stays light. */
  mode?: 'preview' | 'preview-dark';
}
const { title, rates, customer, mode = 'preview' } = Astro.props;
---

<html lang="en" data-mode={mode} data-customer={customer}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {
      /* The link-preview card (src/lib/customer/share.ts). Fixed copy on every page of the realm:
        an unfurler carries no cookie, so it only ever sees the gate, and the card is read by
        everyone in the thread the link was pasted into. It never names the buyer or a rug — not
        even on the signed-in detail page, whose <title> does. `og:url` is deliberately absent:
        it could only be rebuilt from the Host header behind the proxy, and a wrong canonical is
        worse than none — every app falls back to the address it was given. */
    }
    <meta name="description" content={SHARE_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SHARE_SITE_NAME} />
    <meta property="og:title" content={SHARE_TITLE} />
    <meta property="og:description" content={SHARE_DESCRIPTION} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={SHARE_TITLE} />
    <meta name="twitter:description" content={SHARE_DESCRIPTION} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="expect" href="#pv-ready" blocking="render" />
    <script is:inline type="application/json" id="sl-rates" set:html={jsonForScript(rates)} />
  </head>
  <body class="pv">
    <slot />
    <script is:inline set:html={prepaint} />
    <span id="pv-ready" hidden></span>
  </body>
</html>
