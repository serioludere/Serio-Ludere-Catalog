---
// Product Card / Preview (Figma 53:62 and the 358-wide mobile variant).
//
// A 2:3 image box with the like control pinned to its bottom right, then a 12px gap, then four
// centred lines 4px apart — title, method, size, price (method added by the owner, 2026-09-17; it is
// the one spec a buyer scanning a grid asks about before opening the rug). No rating line, no meta
// list, no collection label.
//
// Owner, 2026-09-17: no border on the card, everything centred, and the photo fills the 2:3 box at
// the full height, never shrunk inside padding. The photo keeps a gentle hover zoom.
// Owner, 2026-09-28: the whole rug, always — `contain`, not `cover`. A cover stored at 2:3 (drive/
// transform.ts) fills the box exactly; a taller one still takes the full height; a wider one is shown
// whole rather than having its sides cut off.
import { money, type RateTable } from '../../lib/currency.ts';
import { dims, PREVIEW_SEP } from '../../lib/units.ts';
import { badgesFor, visibleLikes, type CardView } from '../../lib/view.ts';
import Reactions from './Reactions.astro';

interface Props {
  card: CardView;
  rates: RateTable;
  /** Base currency for the server-rendered price; prefs.ts re-renders in the visitor's choice. */
  baseCurrency: string;
  href: string;
  /** The first cards of the grid load eagerly; the very first also gets fetchpriority=high. */
  eager?: boolean;
  priority?: boolean;
}
const { card, rates, baseCurrency, href, eager = false, priority = false } = Astro.props;
const sizeText = dims(card.widthCm, card.lengthCm, 'cm', PREVIEW_SEP);
const priceText = money(card.priceUsd, baseCurrency, rates, 'en-US');
// Owner, 2026-09-13: Signed / Antique badge top-left; like count only from five.
const badges = badgesFor(card.tags.map((t) => t.name));
const likes = visibleLikes(card.likes);
---

<article class="pv-card">
  <div class="pv-card-image" data-fit={card.fillHeight ? 'height' : undefined}>
    {
      card.photoUrl ? (
        <img
          src={card.photoUrl}
          alt={card.name}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <span class="pv-card-empty">Photo to come</span>
      )
    }
    {
      badges.length > 0 && (
        <ul class="pv-card-badges">
          {badges.map((b) => (
            <li class="pv-badge">{b}</li>
          ))}
        </ul>
      )
    }
    <a class="pv-card-hit" href={href} tabindex="-1" aria-hidden="true"></a>
    <div class="pv-card-react">
      {
        /* Rendered server-side, and THRESHOLDED — `likes` is visibleLikes(card.likes), so a rug under
          MIN_VISIBLE_LIKES has no count in the attribute, not merely a hidden one. Emitting
          `card.likes` here shipped the exact sub-5 number to every buyer in the page source while
          the badge was correctly blank, which defeated the requirement it was meant to implement.
          Astro drops an undefined attribute, so `hidden` and the attribute now agree. */
      }
      <span class="pv-card-likes" data-like-count={likes} hidden={likes === undefined}>
        {likes ?? ''}
      </span>
      <Reactions rugId={card.id} mode="card" />
    </div>
  </div>

  <div class="pv-card-text">
    <p class="pv-card-name"><a href={href}>{card.name}</a></p>
    <p class="pv-card-method" hidden={!card.method}>{card.method}</p>
    <p
      class="pv-card-size"
      data-dims
      data-w={card.widthCm ?? ''}
      data-l={card.lengthCm ?? ''}
      data-sep={PREVIEW_SEP}
      hidden={!sizeText}
    >
      {sizeText}
    </p>
    <p class="pv-card-price" data-price data-usd={card.priceUsd ?? ''} hidden={!priceText}>
      {priceText}
    </p>
  </div>
</article>

<style>
  .pv-card {
    display: flex;
    flex-direction: column;
    gap: var(--tight);
    min-width: 0;
  }

  .pv-card-image {
    position: relative;
    aspect-ratio: 2 / 3;
    background: var(--surface);
    overflow: hidden;
  }
  .pv-card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Owner, 2026-09-28, Karavan only (features.ts `coverFullHeight`): the photo at the plate's full
     height, its width following its own shape, centred. A 2:3 cover fills the plate; a taller one
     leaves ivory at its sides; a wider one runs past the plate's sides, which clip it. Every other
     child of the plate is positioned, so the photo is the only flex item. */
  .pv-card-image[data-fit='height'] {
    display: flex;
    justify-content: center;
  }
  .pv-card-image[data-fit='height'] img {
    flex: none;
    width: auto;
    max-width: none;
    height: 100%;
  }
  /* Owner, 2026-10-04: on a phone the photo sits at the TOP of its 2:3 plate, so the rug starts 16
     under the tabs or the collection intro; a squarer photo's spare plate falls below it, not above. */
  @media (max-width: 767px) {
    .pv-card-image img {
      object-position: top;
    }
  }
  /* The storefront's own image hover, at a gentler amount: 600ms ease-out, 4% rather than 30%.
     Pointer devices only. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pv-card-image img {
      transition: transform var(--motion-transition) var(--motion-ease);
    }
    .pv-card:hover .pv-card-image img,
    .pv-card:focus-within .pv-card-image img {
      transform: scale(1.04);
    }
  }
  .pv-card-empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink-muted);
  }

  /* An invisible link over the photo, under the reaction control, so the whole image is clickable
     without wrapping the buttons in an anchor. */
  .pv-card-hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* Bottom-right, on the owner's instruction (2026-09-13). Figma 53:62 pins this control to the TOP
     right; moving it frees that corner for the Signed / Antique badge, so the two changes fit
     together rather than fighting for the same spot. */
  .pv-card-react {
    position: absolute;
    bottom: var(--tight);
    right: var(--tight);
    z-index: 2;
    display: flex;
    align-items: center;
  }

  /* The count sits left of the heart so the circle stays hard against the corner. Mono, so a card
     ticking from 9 to 10 does not shift the heart sideways.
     Owner, 2026-10-03: no chip behind it — the number is drawn like the heart beside it, in cream with
     the heart's own glyph shadow, and 8px from the heart you can SEE. The heart's 64px button keeps
     18px of empty hit area left of the stroke ((64 − 36) / 2 for the glyph box, plus the artwork's
     4px inset), so the margin takes that back. */
  .pv-card-likes {
    margin-inline-end: calc(var(--stack-sm) - 18px);
    font-family: var(--mono);
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--ink-cream);
    filter: var(--shadow-glyph);
  }

  /* Top-left, opposite the heart. A list because a rug can be both Signed and Antique. */
  .pv-card-badges {
    position: absolute;
    top: var(--tight);
    left: var(--tight);
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--stack-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pv-badge {
    padding: 2px 6px;
    background: var(--ink);
    color: var(--surface);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: none;
    line-height: 1.5;
    white-space: nowrap;
  }

  .pv-card-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--stack-xs);
    text-align: center;
  }
  .pv-card-name {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.35;
    text-wrap: balance;
  }
  .pv-card-name a {
    text-decoration: none;
    transition: color var(--motion-quick) var(--motion-ease);
  }
  .pv-card-name a:hover {
    color: var(--brand);
  }
  /* The same weight as the size line below it: both are secondary facts about the rug, and giving
     one of them its own tone would invent a hierarchy between them that the design does not have.
     No tabular-nums — it is a word, not a measurement. */
  .pv-card-method {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .pv-card-size {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .pv-card-price {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
