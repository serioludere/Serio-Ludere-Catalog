---
// The product popup on the customer grid (owner, 2026-09-20): clicking a card opens the rug here
// rather than navigating to its own page. Photo on the left, everything known about the rug on the
// right, and no empty band above either.
//
// Every rug's content is server-rendered into a <template> beside the grid, and the script clones
// one into the single dialog below. Two reasons it is not fetched on click: the detail page's layout
// styles are scoped to THAT page, so its markup would arrive here unstyled — and cloning is instant,
// where a fetch would put a spinner between the click and the rug on a catalogue this small.
//
// The cards stay real links to `/{slug}/{id}`. That page is unchanged and still the thing a shared
// link, a new tab or a browser without JavaScript opens; this only intercepts a plain left click.
import { badgesFor, type CardView } from '../../lib/view.ts';
import { driveImageUrl } from '../../lib/images.ts';
import { money, type RateTable } from '../../lib/currency.ts';
import { dims, PREVIEW_SEP } from '../../lib/units.ts';
import Reactions from './Reactions.astro';
import SpecTable from './SpecTable.astro';

interface Props {
  cards: readonly CardView[];
  rates: RateTable;
  baseCurrency: string;
}
const { cards, rates, baseCurrency } = Astro.props;

const photosOf = (card: CardView): string[] =>
  card.photoUrls?.length ? card.photoUrls : card.photoUrl ? [card.photoUrl] : [];
const specRowsOf = (card: CardView): Array<{ key: string; value: string }> => [
  { key: 'Size', value: dims(card.widthCm, card.lengthCm, 'cm', PREVIEW_SEP) },
  { key: 'Material', value: card.material },
  { key: 'Method', value: card.method },
  { key: 'Origin', value: card.origin },
  { key: 'Pile', value: card.pile },
  { key: 'Age', value: card.age },
];
---

{
  cards.map((card) => {
    const photos = photosOf(card);
    const thumbs = (card.photoIds ?? []).map((id) => driveImageUrl(id, 400));
    const priceText = money(card.priceUsd, baseCurrency, rates, 'en-US');
    return (
      <template data-detail={card.id}>
        <div class="pv-modal__media">
          {/* The rug and its weave, side by side (owner, 2026-09-21). The texture used to sit under
              the title in the facts column, where it read as an afterthought to the price; beside
              the hero it does the job it is for — the whole piece from across a room, and the knot
              in the hand, in one look. */}
          <div class:list={['pv-modal__plates', { 'has-texture': Boolean(card.textureUrl) }]}>
            {photos[0] ? (
              <img class="pv-modal__photo" src={photos[0]} alt={card.name} data-hero-img decoding="async" />
            ) : (
              <span class="pv-modal__empty">Photo to come</span>
            )}
            {card.textureUrl && (
              <figure class="pv-modal__texture">
                <img
                  src={card.textureUrl}
                  alt={`${card.name}, the weave up close`}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="pv-modal__texture-label">texture</figcaption>
              </figure>
            )}
          </div>
          {photos.length > 1 && (
            <div class="pv-thumbs pv-modal__thumbs" data-thumbs role="toolbar" aria-label="Photographs">
              {photos.map((src, i) => (
                <button
                  type="button"
                  class:list={['pv-thumb', { 'is-on': i === 0 }]}
                  data-full={src}
                  data-alt={`${card.name}, photograph ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                >
                  <img src={thumbs[i] ?? src} alt={`Photograph ${i + 1}`} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="pv-modal__info">
          {/* The h2, not an h1: the page already has one, and the dialog is a section of it. */}
          <h2 class="pv-h1 pv-modal__name">{card.name}</h2>
          <p class="pv-price" data-price data-usd={card.priceUsd ?? ''} hidden={!priceText}>
            {priceText}
          </p>
          {
            /* The markers: the same two the card corner shows, spelled out here where there is room
               for the word. They are back to being unconditional — the texture photograph moved to
               the media column beside the hero (owner, 2026-09-21), so it no longer takes this slot. */
            badgesFor(card.tags.map((t) => t.name)).length > 0 && (
              <ul class="pv-modal__markers">
                {badgesFor(card.tags.map((t) => t.name)).map((b) => (
                  <li class="pv-modal__marker">{b}</li>
                ))}
              </ul>
            )
          }
          {card.description && <p class="pv-modal__desc">{card.description}</p>}
          <div class="pv-modal__react">
            <Reactions rugId={card.id} mode="detail" />
            {/* The heart alone says nothing until you already know what it does (owner, 2026-09-20).
                The button keeps its own "Like this rug" for screen readers; this is the visible word
                beside it, and it is not a second control — clicking it does nothing. */}
            <span class="pv-modal__react-label" aria-hidden="true">
              Like
            </span>
          </div>
          <SpecTable rows={specRowsOf(card)} widthCm={card.widthCm} lengthCm={card.lengthCm} />
        </div>
      </template>
    );
  })
}

<dialog class="pv-modal" data-product-dialog aria-label="Rug">
  <button type="button" class="pv-modal__close" data-product-close aria-label="Close">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-linecap="round"></path>
    </svg>
  </button>
  <div class="pv-modal__body" data-product-body></div>
</dialog>

<script>
  import { initProductDialog } from '../../scripts/customer/product-dialog.ts';
  initProductDialog();
</script>

<style>
  /* Split view: photo left, facts right. `--pv-modal-*` are only used here. */
  .pv-modal {
    /* A flex column, so the body can be told to fill what is left and scroll INSIDE the dialog.
       Without it the two columns size to their content and run off the bottom of the dialog. */
    display: flex;
    flex-direction: column;
    width: min(1100px, calc(100vw - var(--gutter) * 2));
    max-width: none;
    max-height: min(760px, calc(100dvh - var(--gutter) * 2));
    padding: 0;
    border: var(--rule-width) solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
  }
  .pv-modal:not([open]) {
    display: none;
  }
  .pv-modal::backdrop {
    background: var(--bg-overlay);
  }
  .pv-modal__body {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    /* The photo takes the larger half and the facts column is allowed to scroll on its own, so a
       long description never pushes the photo off the top of the dialog. */
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
  }
  .pv-modal__media {
    display: flex;
    flex-direction: column;
    gap: var(--stack-md);
    min-width: 0;
    min-height: 0;
    padding: var(--stack-lg);
    background: var(--bg-inset);
    border-right: var(--rule-width) solid var(--rule);
  }
  /* Hero and texture share the media column's height; the texture takes a third of its width, so a
     rug still reads as the subject and the weave as the detail. Without a texture the hero simply
     has the row to itself and nothing about the old layout changes. */
  .pv-modal__plates {
    flex: 1 1 auto;
    display: flex;
    gap: var(--stack-md);
    min-width: 0;
    min-height: 0;
  }
  .pv-modal__photo {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    min-height: 0;
    /* `contain`, like the card: a rug is never cropped to fit a box (ADR D6). */
    object-fit: contain;
  }
  .pv-modal__plates.has-texture .pv-modal__photo {
    width: auto;
  }
  .pv-modal__empty {
    display: grid;
    flex: 1 1 auto;
    place-items: center;
    color: var(--ink-muted);
    font-family: var(--body);
    font-size: var(--text-sm);
  }
  /* The strip is drawn by the detail page's own scoped styles, which do not reach the grid page —
     so the dialog's copy carries its own, at the smaller size this column has room for. */
  .pv-modal__thumbs {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    gap: var(--stack-sm);
    overflow-x: auto;
  }
  .pv-modal__thumbs .pv-thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 80px;
    padding: 0;
    border: var(--rule-width) solid var(--rule);
    background: none;
    cursor: pointer;
  }
  .pv-modal__thumbs .pv-thumb.is-on {
    border: 2px solid var(--ink);
  }
  .pv-modal__thumbs .pv-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pv-modal__info {
    display: flex;
    flex-direction: column;
    gap: var(--stack-md);
    min-width: 0;
    min-height: 0;
    padding: var(--stack-xl);
    overflow-y: auto;
  }
  .pv-modal__name {
    margin: 0;
  }
  .pv-modal__markers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--stack-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The texture plate: a full-height column beside the hero. `cover`, not `contain` — a crop of a
     close-up is still a close-up, where letterboxing it would waste the room it has. */
  .pv-modal__texture {
    flex: 0 0 32%;
    display: flex;
    flex-direction: column;
    gap: var(--stack-xs);
    min-width: 0;
    margin: 0;
  }
  .pv-modal__texture img {
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    object-fit: cover;
    border: var(--rule-width) solid var(--rule);
  }
  .pv-modal__texture-label {
    flex: none;
    font-family: var(--body);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-align: center;
  }
  .pv-modal__marker {
    padding: var(--corner-chip-pad, 2px 6px);
    border: var(--rule-width) solid var(--rule);
    font-family: var(--body);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  .pv-modal__desc {
    margin: 0;
    font-family: var(--body);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--ink-soft);
  }
  .pv-modal__react {
    display: flex;
    align-items: center;
    gap: var(--stack-sm);
  }
  /* The heart is drawn white, to sit on top of a photograph. Here it sits on the panel beside the
     facts, so it takes the page's ink; liked still turns it red, from the component's own rule. */
  .pv-modal__react :global(.pv-circle) {
    color: var(--ink);
  }
  /* …and so it needs no shadow (owner, 2026-09-22). The shadow exists for the CARD, where a cream
     heart sits on a photograph that may be cream too; here it is ink on the cream panel, already
     unmistakable, and a shadow only smudges its edge.

     `.pv-circle` is in the selector on purpose: without it this compiles to the same specificity as
     the card's own rule in Reactions.astro (0,3,1 each), and which one won would depend on the order
     the two stylesheets happened to load in. With it, this rule wins outright. */
  .pv-modal__react :global(.pv-circle .pv-glyph svg) {
    filter: none;
  }
  .pv-modal__react-label {
    font-family: var(--body);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  /* The spec panel is drawn for a page column; inside the dialog it is already on a panel. */
  .pv-modal__info :global(.pv-spec) {
    padding: 0;
    border: 0;
    background: none;
  }
  .pv-modal__close {
    position: absolute;
    inset-block-start: var(--stack-sm);
    inset-inline-end: var(--stack-sm);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: var(--rule-width) solid var(--rule);
    border-radius: 100%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .pv-modal__close:hover {
    color: var(--brand);
  }

  /* One column on a phone: photo first, facts under it, the whole dialog scrolling as one. */
  @media (max-width: 767px) {
    .pv-modal {
      width: 100vw;
      max-width: 100vw;
      max-height: 92dvh;
      margin: auto auto 0;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .pv-modal__body {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    .pv-modal__media {
      border-right: 0;
      border-bottom: var(--rule-width) solid var(--rule);
    }
    .pv-modal__photo {
      max-height: 46dvh;
    }
    /* Side by side still — the pair IS the point — but the weave gives up width first, and the row
       keeps the hero's height so neither plate stretches. */
    .pv-modal__plates.has-texture .pv-modal__photo {
      max-height: 34dvh;
    }
    .pv-modal__texture {
      flex-basis: 28%;
    }
    .pv-modal__texture img {
      max-height: 34dvh;
    }
    .pv-modal__info {
      overflow: visible;
      padding: var(--stack-lg);
    }
  }
</style>
