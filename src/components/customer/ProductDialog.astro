---
// The product popup on the customer grid (owner, 2026-09-20): clicking a card opens the rug here
// rather than navigating to its own page. Photo on the left, everything known about the rug on the
// right, and no empty band above either.
//
// Every rug's content is server-rendered into a <template> beside the grid, and the script clones
// one into the single dialog below. Two reasons it is not fetched on click: the detail page's layout
// styles are scoped to THAT page, so its markup would arrive here unstyled — and cloning is instant,
// where a fetch would put a spinner between the click and the rug on a catalogue this small.
//
// The cards stay real links to `/{slug}/{id}`. That page is unchanged and still the thing a shared
// link, a new tab or a browser without JavaScript opens; this only intercepts a plain left click.
import { badgesFor, type CardView } from '../../lib/view.ts';
import { driveImageUrl } from '../../lib/images.ts';
import { money, type RateTable } from '../../lib/currency.ts';
import { dims, PREVIEW_SEP } from '../../lib/units.ts';
import Reactions from './Reactions.astro';
import SpecTable from './SpecTable.astro';

interface Props {
  cards: readonly CardView[];
  rates: RateTable;
  baseCurrency: string;
}
const { cards, rates, baseCurrency } = Astro.props;

const photosOf = (card: CardView): string[] =>
  card.photoUrls?.length ? card.photoUrls : card.photoUrl ? [card.photoUrl] : [];
const specRowsOf = (card: CardView): Array<{ key: string; value: string }> => [
  { key: 'Size', value: dims(card.widthCm, card.lengthCm, 'cm', PREVIEW_SEP) },
  { key: 'Material', value: card.material },
  { key: 'Method', value: card.method },
  { key: 'Origin', value: card.origin },
  { key: 'Pile', value: card.pile },
  { key: 'Age', value: card.age },
];
---

{
  cards.map((card) => {
    const photos = photosOf(card);
    const thumbs = (card.photoIds ?? []).map((id) => driveImageUrl(id, 400));
    const priceText = money(card.priceUsd, baseCurrency, rates, 'en-US');
    return (
      <template data-detail={card.id}>
        <div class="pv-modal__media">
          {/* The rug and its weave, side by side (owner, 2026-09-21). The texture used to sit under
              the title in the facts column, where it read as an afterthought to the price; beside
              the hero it does the job it is for — the whole piece from across a room, and the knot
              in the hand, in one look.

              Two equal pictures (owner, 2026-09-30: "the same dimensions and size, ratio as the main
              thumbnail next to it, these 2 should look equal, even if we had to extend the popup
              width"): the texture takes the exact size and shape of the rug photograph beside it
              (the styles below say how), and the rug is shown whole, as everywhere. A plain picture,
              no longer a button that enlarges it (owner, same day: "no need for the zoom"). */}
          <div class:list={['pv-modal__plates', { 'has-texture': Boolean(card.textureUrl) }]}>
            {photos[0] ? (
              <img class="pv-modal__photo" src={photos[0]} alt={card.name} data-hero-img decoding="async" />
            ) : (
              <span class="pv-modal__empty">Photo to come</span>
            )}
            {card.textureUrl && (
              <figure class="pv-modal__texture">
                <img
                  src={card.textureUrl}
                  alt={`${card.name}, the weave up close`}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="pv-modal__texture-label">texture</figcaption>
              </figure>
            )}
          </div>
          {photos.length > 1 && (
            <div class="pv-thumbs pv-modal__thumbs" data-thumbs role="toolbar" aria-label="Photographs">
              {photos.map((src, i) => (
                <button
                  type="button"
                  class:list={['pv-thumb', { 'is-on': i === 0 }]}
                  data-full={src}
                  data-alt={`${card.name}, photograph ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                >
                  <img src={thumbs[i] ?? src} alt={`Photograph ${i + 1}`} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="pv-modal__info">
          {/* The h2, not an h1: the page already has one, and the dialog is a section of it. */}
          <h2 class="pv-h1 pv-modal__name">{card.name}</h2>
          <p class="pv-price" data-price data-usd={card.priceUsd ?? ''} hidden={!priceText}>
            {priceText}
          </p>
          {
            /* The markers: the same two the card corner shows, spelled out here where there is room
               for the word. They are back to being unconditional — the texture photograph moved to
               the media column beside the hero (owner, 2026-09-21), so it no longer takes this slot. */
            badgesFor(card.tags.map((t) => t.name)).length > 0 && (
              <ul class="pv-modal__markers">
                {badgesFor(card.tags.map((t) => t.name)).map((b) => (
                  <li class="pv-modal__marker">{b}</li>
                ))}
              </ul>
            )
          }
          {card.description && <p class="pv-modal__desc">{card.description}</p>}
          <div class="pv-modal__react">
            {/* The heart alone (owner, 2026-09-29: the visible "Like" beside it, added 2026-09-20, is
                gone). The button still carries its own "Like this rug" for screen readers. */}
            <Reactions rugId={card.id} mode="detail" />
          </div>
          <SpecTable rows={specRowsOf(card)} widthCm={card.widthCm} lengthCm={card.lengthCm} />
        </div>
      </template>
    );
  })
}

<dialog class="pv-modal" data-product-dialog aria-label="Rug">
  <button type="button" class="pv-modal__close" data-product-close aria-label="Close">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-linecap="round"></path>
    </svg>
  </button>
  <div class="pv-modal__body" data-product-body></div>
</dialog>

<script>
  import { initProductDialog } from '../../scripts/customer/product-dialog.ts';
  initProductDialog();
</script>

<style>
  /* Split view: photo left, facts right. `--pv-modal-*` are only used here. */
  .pv-modal {
    /* How large the rug and its texture can be (owner, 2026-09-30): as tall as the media column
       allows — the dialog's height less the column's padding — and, for the card's 2:3, two-thirds as
       wide. `--pv-pair-w` is the column that holds the two side by side. */
    --pv-modal-h: min(760px, calc(100dvh - var(--gutter) * 2));
    --pv-thumb-h: 80px;
    --pv-plate-h: calc(var(--pv-modal-h) - var(--stack-lg) * 2);
    --pv-plate-w: calc(var(--pv-plate-h) * 2 / 3);
    --pv-pair-w: calc(var(--pv-plate-w) * 2 + var(--stack-md) + var(--stack-lg) * 2);
    --pv-info-w: 400px;
    /* A flex column, so the body can be told to fill what is left and scroll INSIDE the dialog.
       Without it the two columns size to their content and run off the bottom of the dialog. */
    display: flex;
    flex-direction: column;
    width: min(1100px, calc(100vw - var(--gutter) * 2));
    max-width: none;
    max-height: var(--pv-modal-h);
    padding: 0;
    border: var(--rule-width) solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
  }
  /* A rug with more than one photograph has the strip under the plates; its height comes off theirs. */
  .pv-modal:has(.pv-modal__thumbs) {
    --pv-plate-h: calc(var(--pv-modal-h) - var(--stack-lg) * 2 - var(--pv-thumb-h) - var(--stack-md));
  }
  .pv-modal:not([open]) {
    display: none;
  }
  .pv-modal::backdrop {
    background: var(--bg-overlay);
  }
  .pv-modal__body {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    /* The photo takes the larger half and the facts column is allowed to scroll on its own, so a
       long description never pushes the photo off the top of the dialog. */
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
  }
  /* Wider when the rug has a texture, so the two pictures side by side stay close to the size a rug
     alone gets: the pair's column plus the facts column, as far as the screen allows. Narrower than
     that, the facts keep 380px and the two pictures shrink together, still equal. */
  @media (min-width: 768px) {
    .pv-modal:has(.pv-modal__plates.has-texture) {
      width: min(calc(var(--pv-pair-w) + var(--pv-info-w)), calc(100vw - var(--gutter) * 2));
    }
    .pv-modal__body:has(.pv-modal__plates.has-texture) {
      grid-template-columns: minmax(0, var(--pv-pair-w)) minmax(380px, 1fr);
    }
  }
  .pv-modal__media {
    display: flex;
    flex-direction: column;
    /* The plates and the strip under them sit in the middle when the facts column is the taller. */
    justify-content: center;
    gap: var(--stack-md);
    min-width: 0;
    min-height: 0;
    padding: var(--stack-lg);
    background: var(--bg-inset);
    border-right: var(--rule-width) solid var(--rule);
  }
  /* Without a texture the hero has the row to itself, as tall as the column. */
  .pv-modal__plates {
    flex: 1 1 auto;
    display: flex;
    gap: var(--stack-md);
    min-width: 0;
    min-height: 0;
  }
  .pv-modal__photo {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    min-height: 0;
    /* `contain`, like the card: a rug is never cropped to fit a box (ADR D6). */
    object-fit: contain;
  }
  /* With one, the hero and the texture are two equal pictures (owner, 2026-09-30): the texture takes
     the exact width, height and shape of the rug photograph beside it.

     How: two equal grid columns, and a grid only as wide as it needs to be. The hero is the one item
     with a size of its own — its photograph's shape, as large as the plate height and the column
     allow — so it sets the column width, and the other column matches it. The texture's picture is
     taken out of the flow, so the figure contributes no size and simply stretches to the row the
     hero sets. A rug of any shape — 2:3, 3:4, a runner — gets a texture exactly its size, and the
     rug itself is never cropped. */
  .pv-modal__plates.has-texture {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-self: center;
    width: fit-content;
    max-width: 100%;
  }
  .pv-modal__plates.has-texture .pv-modal__photo {
    justify-self: center;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--pv-plate-h);
  }
  /* No photograph yet: a 2:3 placeholder, the card's own shape, for the texture to match. */
  .pv-modal__plates.has-texture .pv-modal__empty {
    width: var(--pv-plate-w);
    max-width: 100%;
    aspect-ratio: 2 / 3;
  }
  .pv-modal__empty {
    display: grid;
    flex: 1 1 auto;
    place-items: center;
    color: var(--ink-muted);
    font-family: var(--body);
    font-size: var(--text-sm);
  }
  /* The strip is drawn by the detail page's own scoped styles, which do not reach the grid page —
     so the dialog's copy carries its own, at the smaller size this column has room for. */
  .pv-modal__thumbs {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    gap: var(--stack-sm);
    overflow-x: auto;
  }
  .pv-modal__thumbs .pv-thumb {
    flex: 0 0 auto;
    width: 64px;
    height: var(--pv-thumb-h);
    padding: 0;
    border: var(--rule-width) solid var(--rule);
    background: none;
    cursor: pointer;
  }
  .pv-modal__thumbs .pv-thumb.is-on {
    border: 2px solid var(--ink);
  }
  /* `contain`, as on the detail page's strip (owner, 2026-09-28: the whole rug, always). */
  .pv-modal__thumbs .pv-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .pv-modal__info {
    display: flex;
    flex-direction: column;
    gap: var(--stack-md);
    min-width: 0;
    min-height: 0;
    padding: var(--stack-xl);
    overflow-y: auto;
  }
  .pv-modal__name {
    margin: 0;
  }
  .pv-modal__markers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--stack-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The texture plate (owner, 2026-09-30): the photograph fills the box the rug's picture sets, so the
     pair reads as two equal pictures. A close-up of the weave is the same weave edge to edge, so
     filling that shape loses nothing a buyer is looking for — which is why it need not enlarge any
     more. Absolutely placed, so its own size never widens the column or heightens the row. */
  .pv-modal__texture {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }
  .pv-modal__texture img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The word, in the plate's corner rather than under it: a caption below would make this plate
     taller than the rug's. Drawn like the markers, on the panel's own ground so it reads on any weave. */
  .pv-modal__texture-label {
    position: absolute;
    inset-inline-start: var(--stack-sm);
    inset-block-end: var(--stack-sm);
    padding: var(--corner-chip-pad, 2px 6px);
    border: var(--rule-width) solid var(--rule);
    background: var(--surface);
    font-family: var(--body);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  .pv-modal__marker {
    padding: var(--corner-chip-pad, 2px 6px);
    border: var(--rule-width) solid var(--rule);
    font-family: var(--body);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }
  .pv-modal__desc {
    margin: 0;
    font-family: var(--body);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--ink-soft);
  }
  .pv-modal__react {
    display: flex;
    align-items: center;
    gap: var(--stack-sm);
  }
  /* The heart is drawn white, to sit on top of a photograph. Here it sits on the panel beside the
     facts, so it takes the page's ink; liked still turns it red, from the component's own rule. */
  .pv-modal__react :global(.pv-circle) {
    color: var(--ink);
  }
  /* …and so it needs no shadow (owner, 2026-09-22). The shadow exists for the CARD, where a cream
     heart sits on a photograph that may be cream too; here it is ink on the cream panel, already
     unmistakable, and a shadow only smudges its edge.

     `.pv-circle` is in the selector on purpose: without it this compiles to the same specificity as
     the card's own rule in Reactions.astro (0,3,1 each), and which one won would depend on the order
     the two stylesheets happened to load in. With it, this rule wins outright. */
  .pv-modal__react :global(.pv-circle .pv-glyph svg) {
    filter: none;
  }
  /* The spec panel is drawn for a page column; inside the dialog it is already on a panel. */
  .pv-modal__info :global(.pv-spec) {
    padding: 0;
    border: 0;
    background: none;
  }
  .pv-modal__close {
    position: absolute;
    inset-block-start: var(--stack-sm);
    inset-inline-end: var(--stack-sm);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: var(--rule-width) solid var(--rule);
    border-radius: 100%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .pv-modal__close:hover {
    color: var(--brand);
  }

  /* One column on a phone: photo first, facts under it, the whole dialog scrolling as one. */
  @media (max-width: 767px) {
    .pv-modal {
      width: 100vw;
      max-width: 100vw;
      max-height: 92dvh;
      margin: auto auto 0;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .pv-modal__body {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    .pv-modal__media {
      border-right: 0;
      border-bottom: var(--rule-width) solid var(--rule);
    }
    .pv-modal__photo {
      max-height: 46dvh;
    }
    /* With a texture the pair still sits side by side — the pair IS the point — at most half the
       screen's width each, and no taller than a rug alone is here. */
    .pv-modal__plates.has-texture .pv-modal__photo {
      max-height: 46dvh;
    }
    .pv-modal__info {
      overflow: visible;
      padding: var(--stack-lg);
    }
  }
</style>
