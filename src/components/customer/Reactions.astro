---
// The Like control (Figma 18:54, documented at 18:100; owner, 2026-09-15: the dislike half removed).
//
// From the component documentation, because every line of it is load-bearing:
//
//   "Geometry is extracted, not designed: settings_data.blocks[wishlist-product-card] gives
//    border_radius 100, icon_size 18, icon_thickness 1, #000000 on #ffffff. This is the storefront's
//    own wishlist control."
//
//   "Failed: the optimistic state is HELD and a 12px alert glyph appears. Retry is automatic."
//
// Owner, 2026-09-17: the like turns solid red the instant it is tapped. Reactions still buffer 2-3s
// and flush in the background, but that is no longer drawn — the old 45% glyph and muted dot made
// a like look as if it took seconds to register.
//
//   "Accessibility: real focusable buttons with text labels ('Like this rug'), never icon-only.
//    Pressed maps to aria-pressed; the buffered pending state is deliberately NOT announced."
//
// The last sentence is why the syncing dot and the alert glyph are `aria-hidden`: they are visible,
// and silent. The label text is a visually hidden span rather than an aria-label so voice control
// can address the button by the words the design gives it.
//
// The glyph is the exported 16×16 asset drawn at 32×32 (owner, 2026-09-17: 100% bigger), with the
// hard-coded stroke as `currentColor`. It sits at the top-left of a 36×36 box.
interface Props {
  rugId: string;
  /** Where the like is offered: `card` on the grid, `detail` on the rug's own page. */
  mode?: 'card' | 'detail';
}
const { rugId, mode = 'card' } = Astro.props;
---

<div class="pv-react" data-react data-rug={rugId}>
  <button
    type="button"
    class="pv-circle"
    data-vote="like"
    data-source={mode}
    data-rug={rugId}
    aria-pressed="false"
  >
    <span class="pv-glyph" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="32" height="32" fill="none">
        <path
          d="M8 13.4C8 13.4 2.6 10.2 2.6 6.6C2.40109 5.88392 2.49479 5.11814 2.86048 4.47114C3.22618 3.82414 3.83392 3.34891 4.55 3.15C5.26608 2.95109 6.03186 3.04479 6.67886 3.41048C7.32586 3.77618 7.80109 4.38392 8 5.1C8.19891 4.38392 8.67414 3.77618 9.32114 3.41048C9.96814 3.04479 10.7339 2.95109 11.45 3.15C12.1661 3.34891 12.7738 3.82414 13.1395 4.47114C13.5052 5.11814 13.5989 5.88392 13.4 6.6C13.4 10.2 8 13.4 8 13.4Z"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="sr-only">Like this rug</span>
  </button>

  <span class="pv-sync" data-react-sync aria-hidden="true"></span>
  <span class="pv-alert" data-react-alert aria-hidden="true">
    <svg viewBox="0 0 12 12" width="12" height="12" fill="none">
      <path d="M6 1.5 11 10.5H1L6 1.5Z" stroke="currentColor" stroke-linejoin="round"></path>
      <path d="M6 5v2.2" stroke="currentColor" stroke-linecap="round"></path>
      <path d="M6 8.9v.1" stroke="currentColor" stroke-linecap="round"></path>
    </svg>
  </span>
</div>

<style>
  .pv-react {
    display: flex;
    align-items: center;
    gap: var(--tight);
    min-height: 64px;
  }

  /* 64px hit area, no container chrome (owner, 2026-09-16: no circle, no border — just the glyph).
     Neutral is a white outline (owner, 2026-09-17); pressed fills the heart red through currentColor. */
  .pv-circle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 64px;
    height: 64px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-cream);
    cursor: pointer;
  }

  /* The LIKE control departs from the drawn pressed state, on the owner's instruction (2026-09-13):
     "the heart like button should transform to filled red when liked, and outlined with the normal
     one". Only the glyph changes — the button itself never grows a background or border. */
  .pv-circle[data-vote='like'][aria-pressed='true'] {
    color: var(--brand);
  }
  .pv-circle[data-vote='like'][aria-pressed='true'] .pv-glyph svg path {
    fill: var(--brand);
    stroke: var(--brand);
  }

  /* A cream heart on a cream rug is no heart at all (owner, 2026-09-22). The drawn control has no
     background and should not grow one — it sits ON the photograph, and a filled circle behind it
     would be a different control — so the separation is a shadow under the STROKE itself, which is
     what `drop-shadow` on the svg gives and `box-shadow` on the button could not. */
  .pv-glyph svg {
    filter: var(--shadow-glyph);
  }

  /* The glyph box is 36 with the 32px artwork at its top-left: the drawn 18/16 geometry, doubled. */
  .pv-glyph {
    position: relative;
    display: block;
    width: 36px;
    height: 36px;
  }
  .pv-glyph svg {
    position: absolute;
    left: 0;
    top: 0;
  }

  /* The background save is not drawn (owner, 2026-09-17): the marker stays in the markup for
     votes.ts, but a tapped heart is fully red straight away. */
  .pv-sync {
    display: none;
  }

  /* Failed: the optimistic state stays put and this appears beside it. Retry is automatic, so there
     is no button here — the glyph is a status, not a control. */
  .pv-alert {
    display: none;
    flex: none;
    width: 12px;
    height: 12px;
    color: var(--brand);
  }
  .pv-react[data-failed] .pv-alert {
    display: block;
  }
</style>

<script>
  import { initVotes } from '../../scripts/votes.ts';
  initVotes();
</script>
