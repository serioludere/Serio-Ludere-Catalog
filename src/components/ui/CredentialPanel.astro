---
// Link Panel — Figma 20:91, reduced. Shown on /admin/clients when a customer link is created.
//
// The border is 2px, deliberately the same weight as a focus ring, which makes this the loudest
// surface in the admin.
//
// It carried a reveal-once password until 2026-09-16. Every buyer now signs in with the one shared
// catalogue password, so there is no per-customer secret to show, warn about or regenerate — what is
// left is the one thing the studio actually sends: the link.
//
// `url` may be empty at render: on /admin/clients the value only exists in the create RESPONSE, so
// the panel ships blank and clients.ts fills `[data-credential-url]` and re-points the copy control.
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  url: string;
  title?: string;
  class?: string;
}
const { url, title = 'Link created', class: className } = Astro.props;
---

<section class:list={['credential', className]} aria-label={title}>
  <div class="credential__head">
    <h2 class="credential__title">{title}</h2>
    <p class="credential__note">Send this to the buyer; they sign in with the catalogue password.</p>
  </div>

  <div class="credential__field">
    <span class="credential__label" id="cred-url-label">Preview URL</span>
    <div class="credential__value">
      <span data-credential-url>{url}</span>
      <button
        type="button"
        class="credential__copy"
        data-copy={url}
        data-copy-what="url"
        aria-describedby="cred-url-label"
      >
        <Icon name="copy" />
        <span class="sr-only">Copy preview URL</span>
      </button>
    </div>
  </div>

  <Button style="primary" data-copy={url} data-copy-what="both" class="credential__both"> Copy link </Button>
</section>
