---
// `/{customer-slug}/{productId}` — one rug inside a buyer's private preview
// (Figma "G3 · Product detail", 57:223).
//
// Addressed by Product ID, not by handle: the brief keys everything on the manually assigned id, and
// a buyer's link should survive the studio renaming a rug.
//
// Four bands, 64 apart: a back bar, a full-bleed hero on the surface with the reaction pair pinned
// to its top right, a thumbnail strip, and a two-column body — a fixed 620 text column beside the
// specification panel, 112 apart. There is no enquiry action anywhere; the studio email lives in the
// footer, which is the one contact route the brief allows.
export const prerender = false;

import PreviewControls from '../../components/customer/PreviewControls.astro';
import PreviewFooter from '../../components/customer/PreviewFooter.astro';
import PreviewHeader from '../../components/customer/PreviewHeader.astro';
import PreviewLayout from '../../components/customer/PreviewLayout.astro';
import Reactions from '../../components/customer/Reactions.astro';
import SpecTable from '../../components/customer/SpecTable.astro';
import Pager from '../../components/Pager.astro';
import { money } from '../../lib/currency.ts';
import { findCustomer } from '../../lib/customer/http.ts';
import { baseCurrency, loadCatalogue, ratesFor } from '../../lib/runtime.ts';
import { dims, PREVIEW_SEP } from '../../lib/units.ts';
import { driveImageUrl } from '../../lib/images.ts';
import { catalogueRugs, cardView, tagSlug, type CardView } from '../../lib/view.ts';

const slug = (Astro.params.slug ?? '').toLowerCase();
const productId = Astro.params.productId ?? '';
const { snapshot, error } = await loadCatalogue();
const catalogue = snapshot?.catalogue ?? { rugs: [], collections: [], tags: [], rates: [], customers: [] };
const rates = ratesFor(catalogue);
const customer = snapshot ? findCustomer(catalogue.customers, slug) : undefined;
const signedIn = Astro.locals.customer === slug;

const cards = customer && signedIn ? catalogueRugs(catalogue).map((r) => cardView(r, catalogue)) : [];
const card = cards.find((c) => c.id === productId);

Astro.cache?.set(false);
Astro.response.headers.set('cache-control', 'no-store');
if (error || !snapshot) {
  Astro.response.status = 503;
  Astro.response.statusText = 'Service Unavailable';
  Astro.response.headers.set('retry-after', '60');
} else if (!customer) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
} else if (!signedIn) {
  // A deep link into someone's preview: send them to their own gate, which then returns here.
  return Astro.redirect(`/${slug}`, 303);
} else if (!card) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

/* Where the buyer came from. The grid writes its active chip to `?tag=` (scripts/filters.ts) and
   the card links carry it here, so every way OUT of this page — the back link, prev/next, the
   recovery link on a missing rug — returns them to the grid they were actually looking at. Without
   it, filtering to Kilim, opening a rug and pressing Back dropped them into the unfiltered grid
   with their place lost; only the browser's own Back button happened to work. */
const TAG_RE = /^[a-z0-9-]{1,80}$/;
const rawTag = Astro.url.searchParams.get('tag');
const fromTag = rawTag && TAG_RE.test(rawTag) ? rawTag : undefined;
const q = fromTag ? `?tag=${encodeURIComponent(fromTag)}` : '';
const gridHref = `/${slug}${q}`;
const hrefForCard = (c: CardView): string => `/${slug}/${encodeURIComponent(c.id)}${q}`;

/* Prev/next run the flat grid order, not a collection run: the preview grid is one ungrouped wall
   filtered by TAG, so `siblings()` — which walks the same-collection run the public catalogue is
   built from — would step through rugs the buyer cannot currently see. `liked` is per-visitor and
   lives only in their browser, so it cannot narrow a server-rendered run; it still rides along in
   the href so returning to the grid restores the shortlist. */
const inTag = (c: CardView): boolean =>
  c.tags.some((t) => (t.slug || tagSlug(t.name, catalogue.tags)) === fromTag);
const tagged = fromTag && fromTag !== 'liked' ? cards.filter(inTag) : [];
const run = card && tagged.includes(card) ? tagged : cards;
const at = card ? run.indexOf(card) : -1;
const sib = at >= 0 ? { index: at, total: run.length, prev: run[at - 1], next: run[at + 1] } : undefined;

const priceText = card ? money(card.priceUsd, baseCurrency, rates, 'en-US') : '';
const sizeText = card ? dims(card.widthCm, card.lengthCm, 'cm', PREVIEW_SEP) : '';
const photos = card?.photoUrls?.length ? card.photoUrls : card?.photoUrl ? [card.photoUrl] : [];
// The thumbnails paint a 96×120 box, so they take the 400 tier; the 1600 stays on data-full for the
// hero swap. Before this every thumbnail fetched the full-size file to fill a thumbnail.
const thumbs = (card?.photoIds ?? []).map((id) => driveImageUrl(id, 400));
const specRows = card
  ? [
      { key: 'Size', value: sizeText },
      { key: 'Material', value: card.material },
      { key: 'Method', value: card.method },
      { key: 'Origin', value: card.origin },
      // `Pile` is in the brief's spec block; `Shape` is stored and deliberately never shown.
      { key: 'Pile', value: card.pile },
      { key: 'Age', value: card.age },
    ]
  : [];
const title = card ? `${card.name} — Serio Ludere` : 'Serio Ludere';
---

<PreviewLayout title={title} rates={rates} customer={signedIn ? slug : undefined}>
  {
    customer && (
      <PreviewHeader
        home={`/${slug}`}
        back={{ href: gridHref, label: 'Back to the collection', shortLabel: 'Back' }}
      />
    )
  }

  {
    error && (
      <main class="pv-state">
        <p class="pv-h3">Could not load the catalogue.</p>
        <p class="pv-lede">
          <a href={Astro.url.pathname}>Try again</a>
        </p>
      </main>
    )
  }

  {
    !error && !card && (
      <main class="pv-state">
        <p class="pv-h3">
          {customer ? 'This rug is not in your preview.' : 'This preview link is not active.'}
        </p>
        {customer && (
          <p class="pv-lede">
            <a href={gridHref}>Back to the collection</a>
          </p>
        )}
      </main>
    )
  }

  {
    card && (
      <main class="pv-main">
        <section class="pv-hero">
          {photos[0] ? (
            <img src={photos[0]} alt={card.name} data-hero-img fetchpriority="high" decoding="async" />
          ) : (
            <span class="pv-hero-empty">Photo to come</span>
          )}
          <div class="pv-hero-react">
            <Reactions rugId={card.id} mode="detail" />
          </div>
        </section>

        {photos.length > 1 && (
          <section class="pv-wrap pv-thumbwrap">
            <div class="pv-thumbs" data-thumbs role="toolbar" aria-label="Photographs">
              {photos.map((src, i) => (
                <button
                  type="button"
                  class:list={['pv-thumb', { 'is-on': i === 0 }]}
                  data-full={src}
                  data-alt={`${card.name}, photograph ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                >
                  <img src={thumbs[i] ?? src} alt={`Photograph ${i + 1}`} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </section>
        )}

        <section class="pv-body">
          <div class="pv-detail-text">
            <h1 class="pv-h1">{card.name}</h1>

            <div class="pv-price-row">
              <p class="pv-price" data-price data-usd={card.priceUsd ?? ''} hidden={!priceText}>
                {priceText}
              </p>
              <span class="pv-spacer" aria-hidden="true" />
              <PreviewControls rates={rates} />
            </div>

            {card.description && <p class="pv-detail-desc">{card.description}</p>}

            <div class="pv-react-row">
              <Reactions rugId={card.id} mode="detail" />
              <p class="pv-react-note" data-react-note aria-live="off" />
            </div>
          </div>

          <SpecTable rows={specRows} widthCm={card.widthCm} lengthCm={card.lengthCm} />
        </section>

        {/* Until this existed the only way on from a rug was back to the grid, so reviewing forty
            of them meant forty round trips. The public catalogue has had prev/next since the first
            brief; the preview — the realm the buyer actually uses — shipped without it, though
            Pager's own `hrefFor` was written for exactly this. */}
        {sib && sib.total > 1 && (
          <nav class="pv-wrap pv-pager" aria-label="Rugs in this view">
            <Pager
              prev={sib.prev}
              next={sib.next}
              index={sib.index + 1}
              total={sib.total}
              hrefFor={hrefForCard}
            />
          </nav>
        )}
      </main>
    )
  }

  <PreviewFooter />
</PreviewLayout>

<style>
  /* Full-bleed band on the surface, 620 tall, with the photo capped at the drawn 560×400 box. */
  .pv-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 620px;
    background: var(--surface);
    border-bottom: var(--rule-width) solid var(--rule);
  }
  .pv-hero img {
    /* The drawn 560×400 cap left a small rug adrift in a 620 band; the photo is the page, so it
       takes the room the band already reserves for it. */
    max-width: min(760px, calc(100% - 2 * var(--gutter)));
    max-height: 520px;
    object-fit: contain;
  }
  .pv-hero-empty {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .pv-hero-react {
    position: absolute;
    top: 32px;
    right: 32px;
  }

  .pv-thumbs {
    display: flex;
    gap: var(--stack-sm);
    flex-wrap: wrap;
  }
  .pv-thumb {
    width: 96px;
    height: 120px;
    padding: 0;
    border: var(--rule-width) solid var(--border-control);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
    overflow: hidden;
  }
  .pv-thumb:hover {
    border-color: var(--border-strong);
  }
  .pv-thumb.is-on {
    border: var(--border-width-focus) solid var(--border-strong);
  }
  .pv-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  /* A fixed 620 text column beside the panel, 112 apart, both starting at the top. */
  .pv-body {
    display: flex;
    align-items: flex-start;
    gap: var(--space-section);
    padding: var(--section-gap) var(--gutter);
  }
  .pv-detail-text {
    /* Grows with the screen to a readable 760, shrinks below 620 when it must; the panel takes the
       rest of the row. */
    flex: 1 1 620px;
    max-width: 760px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }
  .pv-price-row {
    display: flex;
    align-items: center;
    gap: var(--stack-md);
  }
  /* H3, not H1: the price sits one step below the title (151:15 draws 19.8 against the title's 28.8). */
  .pv-price {
    font-size: var(--h3);
    font-weight: 700;
    line-height: var(--leading-heading);
  }
  .pv-detail-desc {
    /* Body L (57:253) — the lead step, which drops to 13 at 390 through the token layer. */
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }
  .pv-react-row {
    display: flex;
    align-items: center;
    gap: var(--tight);
  }
  .pv-react-note {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .pv-state {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--stack-md);
    padding: var(--space-section) var(--gutter);
    text-align: center;
  }

  /* Pager carries no styles of its own — `.pager` lives in editorial.css, which the preview realm
     deliberately does not import — so the strip is dressed here in this realm's own idiom: the
     Label style, a hairline above it, brand red on hover like every other preview link. */
  .pv-pager {
    padding-top: var(--section-gap);
    border-top: var(--rule-width) solid var(--rule);
  }
  .pv-pager :global(.pager) {
    display: flex;
    align-items: center;
    gap: var(--stack-md);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-body);
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .pv-pager :global(.pager a) {
    color: var(--ink);
    text-decoration: none;
  }
  .pv-pager :global(.pager a:hover) {
    color: var(--brand);
  }
  /* The absent neighbour keeps its slot so the row never jumps, and is hidden from assistive tech
     by the component itself (aria-hidden). */
  .pv-pager :global(.pager .is-off) {
    visibility: hidden;
  }
  /* The position sits in the middle and takes the slack, so prev hugs left and next hugs right. */
  .pv-pager :global(.pager .pos) {
    flex: 1 1 auto;
    text-align: center;
    font-family: var(--mono);
    font-weight: 400;
    color: var(--ink-soft);
  }
  @media (max-width: 767px) {
    .pv-pager {
      padding-inline: var(--stack-lg);
    }
    .pv-pager :global(.pager .word) {
      display: none;
    }
  }

  /* Between the two drawn frames the fixed 620 column plus the panel minimum overran the viewport
     (768–1100 scrolled sideways), so the body stacks one step before the mobile frame needs it. */
  @media (max-width: 1023px) {
    .pv-body {
      flex-direction: column;
    }
    .pv-detail-text {
      flex-basis: auto;
      max-width: none;
      width: 100%;
    }
  }

  @media (max-width: 767px) {
    .pv-hero {
      min-height: 488px;
    }
    .pv-hero img {
      max-width: min(320px, calc(100% - 2 * var(--stack-lg)));
      max-height: 360px;
    }
    .pv-hero-react {
      top: var(--stack-lg);
      right: var(--stack-lg);
    }
    .pv-body {
      flex-direction: column;
      gap: var(--section-gap);
      padding: 0 var(--stack-lg);
    }
    .pv-detail-text {
      flex-basis: auto;
      max-width: none;
      width: 100%;
      /* 58:341 stacks title -> price row -> description 12 apart at 390 (title h22 ends 22, price row
         at 34; price row ends 70, description at 82 — the block's drawn h124), where the desktop
         column uses the 64 section step. */
      gap: var(--stack-md);
    }

    /* 58:342 draws the mobile title at Mobile/H2 (18) — one step below the 19.8 that --h1 falls to
       at 390, so the M3 title is not simply the desktop H1 stepped down by the token layer. */
    .pv-detail-text .pv-h1 {
      font-size: var(--h2);
    }

    /* 151:37 draws the mobile price at Mobile/H4 (14.4), which --h4 already resolves to at 390. */
    .pv-price {
      font-size: var(--h4);
    }
    .pv-price-row {
      flex-wrap: wrap;
    }

    /* M3 (58:341) carries title, price row and description only — at 390 the Like/Dislike pair lives
       solely in the hero (DIFF-3 item 2), so the duplicate row below the description is dropped.
       display:none keeps [data-react-note] in the DOM; votes.ts only ever reads the note beside the
       group it is updating, so the hero pair is unaffected. */
    .pv-react-row {
      display: none;
    }

    /* M3 (58:366) drops the thumbnail strip at 390 — the slot is an empty 390×40 frame with no fill
       and no children (DIFF-3 item 1). The whole <section> goes rather than just .pv-thumbs: an
       empty flex item would still contribute one .pv-main gap of its own. */
    .pv-thumbwrap {
      display: none;
    }

    .pv-state {
      padding-inline: var(--stack-lg);
    }
  }
</style>

<script>
  import { initPreviewGallery } from '../../scripts/preview-gallery.ts';
  initPreviewGallery();
</script>
