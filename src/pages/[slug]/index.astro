---
// `/{customer-slug}` — one buyer's private preview catalog (Figma "G2 · Catalog", 53:33).
//
// This is the last route in the tree on purpose: `/admin`, `/api`, `/rugs` and `/tags` are static
// segments and win against `[slug]`, and src/lib/customer/gate.ts refuses those names as slugs
// anyway. The middleware has already default-denied anything that is not a well-formed slug and
// marked the response no-store; what is left here is the three-way answer:
//
//   unknown or inactive customer → 404 (a typo in a link must not confirm who else exists)
//   known customer, no session   → the password gate, which is header-less and footer-less as drawn
//   known customer, session      → their catalog
//
// A strip of collection tabs (owner, 2026-09-17: never tags), sharing one row with the unit/currency
// controls — "The collection" heading and its standfirst are gone, which is what freed the row.
export const prerender = false;

import PreviewControls from '../../components/customer/PreviewControls.astro';
import PreviewFooter from '../../components/customer/PreviewFooter.astro';
import PreviewGate from '../../components/customer/PreviewGate.astro';
import PreviewHeader from '../../components/customer/PreviewHeader.astro';
import PreviewLayout from '../../components/customer/PreviewLayout.astro';
import ProductCard from '../../components/customer/ProductCard.astro';
import ProductDialog from '../../components/customer/ProductDialog.astro';
import StudioNote from '../../components/customer/StudioNote.astro';
import CollectionFilters from '../../components/customer/CollectionFilters.astro';
import PageNav from '../../components/ui/PageNav.astro';
import { findCustomer, noteVisit } from '../../lib/customer/http.ts';
import { baseCurrency, loadCatalogue, ratesFor } from '../../lib/runtime.ts';
import { catalogueRugs, cardView, navTabs, visibleLikes } from '../../lib/view.ts';

const slug = (Astro.params.slug ?? '').toLowerCase();
const { snapshot, error } = await loadCatalogue();
const catalogue = snapshot?.catalogue ?? { rugs: [], collections: [], tags: [], rates: [], customers: [] };
const rates = ratesFor(catalogue);
const customer = snapshot ? findCustomer(catalogue.customers, slug) : undefined;
const signedIn = Astro.locals.customer === slug;

// Belt and braces: the middleware already marked every realm response uncacheable. `?.` because
// Astro's test container renders without a cache adapter.
Astro.cache?.set(false);
Astro.response.headers.set('cache-control', 'no-store');
if (error || !snapshot) {
  Astro.response.status = 503;
  Astro.response.statusText = 'Service Unavailable';
  Astro.response.headers.set('retry-after', '60');
} else if (!customer) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

// One row per buyer per half hour, appended in the background: never awaited, never fatal.
if (customer && signedIn) noteVisit(slug, Astro.request);

const rugs = customer && signedIn ? catalogueRugs(catalogue) : [];
const cards = rugs.map((r) => cardView(r, catalogue));

// Collections only (owner, 2026-09-17): one chip per collection that has rugs, in the sheet's sort
// order. A collection nothing belongs to is not offered.
const collections = navTabs(rugs, catalogue).filter((t) => t.count > 0);

/* The tab the grid opens on (owner, 2026-09-25): the FIRST collection — Classics, in the studio's
   order — not "All", which now sits last. A `?collection=` link still wins when it names a tab on the
   page ('all' included, which is how coming back from a rug lands on the whole wall again). Decided
   here rather than in filters.ts so the first paint is already the right grid, not the whole wall
   flashing before the script narrows it. */
const wanted = Astro.url.searchParams.get('collection');
const activeFilter =
  wanted && (wanted === 'all' || collections.some((c) => c.slug === wanted))
    ? wanted
    : (collections[0]?.slug ?? 'all');
const shownFirst = (card: (typeof cards)[number]): boolean =>
  activeFilter === 'all' || card.collectionSlugs.includes(activeFilter);
// The first rugs ON SCREEN load eagerly, not the first in the document: under Classics those are
// the first Classics cards, wherever the server's order put them.
const firstShown = new Map(cards.filter(shownFirst).map((card, i) => [card.id, i]));
const intro = collections.find((c) => c.slug === activeFilter)?.description ?? '';

/* The name search (owner, 2026-09-30) filters through the collection tabs' script (filters.ts),
   which only runs where the tab strip is rendered — so it is offered exactly where the tabs are. */
const searchable = collections.length > 0;

// Never the buyer's name (owner, 2026-09-14): the tab title is read over a shoulder, lands in
// browser history, and is what a screen-share shows before anything else.
const title = 'Serio Ludere';

// The gate is on the same cream ground as the catalogue behind it (owner, 2026-09-22, reverting the
// black gate of 2026-09-17): one theme for the whole realm, from the password to the last rug.
---

<PreviewLayout title={title} rates={rates} customer={signedIn ? slug : undefined}>
  {
    error && (
      <main class="pv-state">
        <p class="pv-h3">Could not load the catalogue.</p>
        <p class="pv-lede">
          <a href={`/${slug}`}>Try again</a>
        </p>
      </main>
    )
  }

  {
    !error && !customer && (
      <main class="pv-state">
        <p class="pv-h3">This preview link is not active.</p>
        <p class="pv-lede">Ask the studio for a new one.</p>
      </main>
    )
  }

  {!error && customer && !signedIn && <PreviewGate slug={slug} />}

  {
    !error && customer && signedIn && (
      <>
        {/* On a phone the unit/currency controls sit on the wordmark's row (owner, 2026-09-23); the
            copy in the title row below serves every wider screen. */}
        <PreviewHeader home={`/${slug}`}>
          <PreviewControls rates={rates} placement="header" search={searchable} />
        </PreviewHeader>
        <main class="pv-main">
          {/* The tab strip sticks under the header on scroll (owner, 2026-10-03), so a buyer deep in
              a collection can change it without scrolling back up. It is its own child of <main>
              rather than the first row of the intro section: a sticky box only travels as far as
              its parent, and the intro section ends a few lines down. The anchor marks where the
              bar rests in the flow (scripts/ui/sticky.ts). */}
          <span class="pv-tabbar-anchor" data-tabbar-anchor aria-hidden="true" />
          <div class="pv-tabbar" data-tabbar>
            <div class="pv-wrap pv-title-row">
              {collections.length > 0 && (
                <CollectionFilters collections={collections} active={activeFilter} />
              )}
              <span class="pv-spacer" aria-hidden="true" />
              <PreviewControls rates={rates} search={searchable} />
            </div>
          </div>
          <section class="pv-wrap pv-title">
            {/* The selected collection's own description, as the intro to the cards below it (owner,
                2026-09-18). filters.ts fills it from the pressed tab; blank under "All", and hidden
                outright rather than left as an empty line that would still take its gap. */}
            <p class="pv-lede pv-collection-intro" data-collection-intro hidden={!intro}>
              {intro}
            </p>
            <button class="pv-intro-more" type="button" data-intro-more aria-expanded="false" hidden>
              read more
            </button>
          </section>

          <section class="pv-wrap pv-results">
            {cards.length > 0 ? (
              <div class="pv-grid">
                {cards.map((card) => (
                  <div
                    data-card
                    data-rug={card.id}
                    data-name={card.name}
                    data-collections={card.collectionSlugs.join(' ')}
                    data-likes={visibleLikes(card.likes)}
                    hidden={!shownFirst(card)}
                  >
                    <ProductCard
                      card={card}
                      rates={rates}
                      baseCurrency={baseCurrency}
                      href={`/${slug}/${encodeURIComponent(card.id)}`}
                      eager={(firstShown.get(card.id) ?? Infinity) < 4}
                      priority={firstShown.get(card.id) === 0}
                    />
                  </div>
                ))}
              </div>
            ) : (
              <p class="pv-lede">No rugs published yet.</p>
            )}
            {/* 20 per page (owner, 2026-09-16); filters.ts un-hides it only when there is a page 2. */}
            {/* Clicking a card opens the rug here instead of navigating (owner, 2026-09-20). */}
            <ProductDialog cards={cards} rates={rates} baseCurrency={baseCurrency} />
            <PageNav id="gridPager" label="Rugs" />
            <p class="pv-lede" data-grid-empty hidden>
              Nothing matches that filter yet.
            </p>
            {/* Pressing a chip changes what is on screen and, until this existed, said nothing: the
                public catalogue announces its result count through RugGrid's #grid-live and the
                preview announced nothing at all. One atomic status ("12 rugs shown"), never a bare
                number, and polite so it waits its turn behind the chip's own pressed state. */}
            <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-grid-live />
          </section>
        </main>
        <PreviewFooter />
        {/* Rises from the bottom ten seconds in (owner, 2026-10-03). */}
        <StudioNote />
      </>
    )
  }

  {(error || !customer) && <PreviewFooter />}
</PreviewLayout>

<style>
  /* Explicit columns sharing the full width: four across at desktop, five on a wide monitor, three
     on a laptop, two on a tablet, one on a phone. The drawn 300 fixed width left up to 96px of dead
     space at the right edge of every row on a 1440 screen, and auto-fill changed the card size with
     every few pixels of viewport; a buyer judging rugs wants the same plate size across the row. */
  .pv-grid {
    display: grid;
    /* Owner, 2026-09-20: wider apart across a row — which makes each rug a little smaller — and
       closer together down the page, so a row of rugs reads as a row rather than as four islands. */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--stack-2xl);
    row-gap: var(--stack-xl);
    align-items: start;
    /* The grid band's own bottom padding. --space-section is 112 at >=1024 and 64 at <=767, which is
       what Figma 58:250 draws below the last mobile row. Together with .pv-footer's margin-top of
       --section-gap (64 at both widths) that is 176 of clearance on desktop and 128 at 390 — Figma
       58:230: grid ends y=2026, footer starts y=2090. */
    padding-bottom: var(--space-section);
  }

  @media (min-width: 1800px) {
    .pv-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  @media (max-width: 1199px) {
    .pv-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .pv-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--stack-lg);
    }
  }

  /* The sticky tab bar (owner, 2026-10-03). It pins under the header — whose height sticky.ts
     publishes as --pv-header-h; the fallbacks are that header's own arithmetic, for the frames before
     the script runs — and carries the page ground, so rugs pass under it rather than through it.
     Its 8px of padding gives the pinned tabs room to breathe; everything around it is measured to
     put the tabs, the intro and the grid where they sat before the bar existed:
       tabs     16 + 8      = 24 under the header (owner, 2026-10-03: the drawn 64 was dead space)
       intro    8 + 24      = 32 under the tabs (the 8 + 24 the intro always had)
       grid     8 + 56      = 64 under the intro, or under the tabs when there is no intro
     `<main>`'s own gap is set aside for this, because the spacing between these three now depends on
     whether the intro is showing. */
  .pv-main {
    gap: 0;
    padding-top: calc(var(--stack-xl) - var(--stack-sm));
  }
  .pv-tabbar-anchor {
    display: block;
    height: 0;
  }
  .pv-tabbar {
    position: sticky;
    top: var(
      --pv-header-h,
      calc(2 * var(--stack-md) + var(--leading-heading) * var(--h4) + var(--rule-width))
    );
    z-index: 20;
    padding-block: var(--stack-sm);
    background: var(--canvas);
    transition: box-shadow var(--motion-quick) var(--motion-ease);
  }
  /* An edge only while pinned, so the bar reads as chrome over the rugs; at rest the page is as drawn. */
  .pv-tabbar.is-stuck {
    box-shadow: 0 var(--rule-width) 0 0 var(--rule);
  }
  .pv-title {
    margin-top: var(--stack-xl);
    padding-bottom: var(--stack-sm);
  }
  /* "All" has no description: the intro section then takes no room at all, and the grid sits the
     same 64 under the tabs that it sits under an intro. */
  .pv-title:has(> [data-collection-intro][hidden]) {
    display: none;
  }
  .pv-results {
    margin-top: calc(var(--section-gap) - var(--stack-sm));
  }

  /* The collection description (owner, 2026-09-20). It was --text-lg, a step ABOVE the tab titles
     it sits under; it is body size now, runs the full width of the grid, and is clamped to three
     lines with a 'read more' under it. */
  .pv-collection-intro {
    /* Owner, 2026-09-20: it sat 8px under the tab strip while every other band on this page is 64
       apart, so the description read as part of the tabs rather than as the introduction to the
       rugs. 24 is the page's next step up (--stack-xl) and leaves the strip and the paragraph as
       two things; the 'read more' stays at 8 because it belongs to THIS paragraph, and nesting a
       small step inside a large one is what makes the rhythm read as deliberate. Since the tabs
       moved into their own sticky bar (2026-10-03) the 24 is `.pv-title`'s margin, below. */
    max-width: none;
    /* Owner, 2026-09-25: 11px. It was twice the body size from 2026-09-23, which made the
       introduction louder than the rugs it introduces; it is a quiet note under the tabs now. */
    font-size: 11px;
    /* The body's small-text leading, which is what this size is again. */
    line-height: var(--leading-body);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .pv-collection-intro.is-open {
    display: block;
    overflow: visible;
    -webkit-line-clamp: none;
    line-clamp: none;
  }
  .pv-intro-more {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--body);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .pv-intro-more:hover {
    color: var(--brand);
  }

  .pv-state {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--stack-md);
    padding: var(--space-section) var(--gutter);
    text-align: center;
  }

  @media (max-width: 767px) {
    /* One column, not two: a buyer judging a rug needs the image large. */
    .pv-grid {
      grid-template-columns: 1fr;
      row-gap: var(--stack-xl);
    }
    /* The tabs have this row to themselves on a phone: the unit/currency controls moved up to the
       wordmark's row (owner, 2026-09-23), so this copy of them stands down, and the spacer with it. */
    .pv-title-row {
      gap: var(--stack-sm);
      flex-wrap: wrap;
    }
    /* Owner, 2026-10-04: no dead space between the tabs and the first rug on a phone. The intro sits
       16 under the tabs (8 of it the tab bar's padding), and the grid 16 under the intro, or under
       the tabs when there is no intro (8 of it .pv-title's or the tab bar's bottom padding). */
    .pv-title {
      margin-top: var(--stack-sm);
    }
    .pv-results {
      margin-top: var(--stack-sm);
    }
    .pv-title-row .pv-spacer,
    .pv-title-row :global(.pv-controls) {
      display: none;
    }
    /* The phone header is the controls' row: 12 + 28 + 12 and its hairline (PreviewHeader). */
    .pv-tabbar {
      top: var(--pv-header-h, calc(2 * var(--stack-md) + 28px + var(--rule-width)));
    }
    .pv-state {
      padding-inline: var(--stack-lg);
    }
  }
</style>
