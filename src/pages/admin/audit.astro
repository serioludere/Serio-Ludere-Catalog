---
// /admin/audit — the AuditLog viewer (docs/ADMIN_SPEC.md §2.1, §8.3): newest 100 rows server-rendered
// as text, client-side filter by action / target id, "Load more" through GET /api/admin/audit.
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { auditLabel } from '../../lib/admin/audit-labels.ts';
import { AUDIT_ACTIONS } from '../../lib/admin/audit.ts';
import { fetchAdminSnapshot, type AdminSnapshot } from '../../lib/admin/read.ts';
import { getClient } from '../../lib/runtime.ts';
import { consoleLogger, serializeError } from '../../lib/sheets/errors.ts';

let snapshot: AdminSnapshot | undefined;
let error: string | undefined;
try {
  snapshot = await fetchAdminSnapshot(getClient(), { logger: consoleLogger });
} catch (e) {
  const safe = serializeError(e);
  consoleLogger.error('admin audit read failed', { error: safe });
  error = safe.message;
}
const rows = snapshot?.audit ?? [];
const pretty = (s: string): string => {
  if (!s) return '';
  try {
    return JSON.stringify(JSON.parse(s), null, 2);
  } catch {
    return s;
  }
};
---

<AdminLayout title="Serio Ludere — Activity log" active="audit">
  {error && <div class="msg err on">Could not read the sheet: {error}</div>}
  <div class="page-head">
    <div class="page-head__titles">
      <h1 class="page-head__title">Activity log</h1>
      <p class="page-head__count">
        The newest {rows.length}
        {rows.length === 1 ? 'change' : 'changes'} made in this admin, latest first
      </p>
    </div>
  </div>
  <div class="row">
    {
      /* Both filters were labelled by `aria-label` alone, so the only on-screen clue to what the
        target box filtered was a placeholder that disappeared as soon as you typed into it. The
        visible labels reuse the aria-label wording verbatim and those attributes come off, since a
        real <label for> would otherwise be overridden by them. */
    }
    <div class="narrow field">
      <label class="field__label" for="f_action">Show</label>
      <select id="f_action">
        <option value="">Everything</option>
        {AUDIT_ACTIONS.map((a) => <option value={a}>{auditLabel(a)}</option>)}
      </select>
    </div>
    <div class="grow field">
      <label class="field__label" for="f_target">Product or customer</label>
      <input id="f_target" placeholder="e.g. SL-021" autocomplete="off" />
    </div>
  </div>
  <p class="hint" id="count" role="status" aria-live="polite"></p>
  <div class="table-wrap">
    <table id="auditTable">
      <thead>
        <tr>
          <th>Time</th>
          <th>Who</th>
          <th>What</th>
          <th>Item</th>
          <th>Changes</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((a) => (
            <tr data-action={a.action} data-target={a.targetId.toLowerCase()} data-row={a.row}>
              <td class="mono" data-ts={a.timestamp}>
                {a.timestamp}
              </td>
              <td>{a.actor}</td>
              <td>{auditLabel(a.action)}</td>
              <td class="mono">
                {a.targetTab} {a.targetId}
              </td>
              <td>
                {(a.before || a.after) && (
                  <details>
                    <summary>Show changes</summary>
                    {a.before && <pre>{pretty(a.before)}</pre>}
                    {a.after && <pre>{pretty(a.after)}</pre>}
                  </details>
                )}
              </td>
              <td class="mono">{a.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {rows.length === 0 && <div class="msg busy on">Nothing has changed yet.</div>}
  <div class="actions">
    <button class="btn btn--secondary" id="btnMore" type="button" data-offset={rows.length}>Load more</button>
  </div>
  <div id="m11" class="msg"></div>
  <script>
    import { initAudit } from '../../scripts/admin/audit.ts';
    import { initDashboard } from '../../scripts/admin/dashboard.ts';
    initAudit();
    initDashboard();
  </script>
</AdminLayout>

<style is:global>
  [hidden] {
    display: none !important;
  }
</style>
