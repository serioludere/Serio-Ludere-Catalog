---
// /admin/collections — collections only: inline edit, add, delete (docs/ADMIN_SPEC.md §2.1, §8.3).
// Wired by src/scripts/admin/collections.ts.
//
// Owner, 2026-09-18, three removals: the ▲/▼ reorder pair (and its endpoint) is gone, the tag
// section is gone — tags are assigned on the product form and nowhere else, so there is nothing to
// keep here — and the two hint lines went with them.
//
// Renaming never rewrites rugs (they store display names); the rug counts show what carries each one.
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Modal from '../../components/ui/Modal.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { fetchAdminSnapshot, type AdminSnapshot, syncLabel } from '../../lib/admin/read.ts';
import { getClient } from '../../lib/runtime.ts';
import { consoleLogger, serializeError } from '../../lib/sheets/errors.ts';
import { jsonForScript } from '../../lib/view.ts';
import { COLLECTION_DESCRIPTION_MAX as DESCRIPTION_MAX } from '../../lib/admin/dto.ts';

let snapshot: AdminSnapshot | undefined;
let error: string | undefined;
try {
  snapshot = await fetchAdminSnapshot(getClient(), { logger: consoleLogger });
} catch (e) {
  const safe = serializeError(e);
  consoleLogger.error('admin collections read failed', { error: safe });
  error = safe.message;
}
const rugs = snapshot?.rugs ?? [];
const rugCount = (name: string): number =>
  rugs.filter((r) => r.collection.trim().toLowerCase() === name.trim().toLowerCase()).length;
const collections = (snapshot?.collections ?? [])
  .slice()
  .sort((a, b) => (a.sortOrder ?? 1e9) - (b.sortOrder ?? 1e9) || a.name.localeCompare(b.name));
const data = { collections: collections.map((c) => ({ ...c, rugs: rugCount(c.name) })) };

// Figma 25:236 — the topbar's status line. Empty on every screen until now.
const syncLabel_ = snapshot ? syncLabel(snapshot.fetchedAt) : undefined;
---

<AdminLayout title="Serio Ludere — Collections" active="collections" meta={syncLabel_}>
  {error && <div class="msg err on">Could not read the sheet: {error}</div>}

  <section class="stack" aria-labelledby="h-collections">
    <div class="page-head">
      <div class="page-head__titles">
        <h1 class="page-head__title">Collections</h1>
        <p class="page-head__count" id="collectionCount">
          {collections.length}
          {collections.length === 1 ? 'collection' : 'collections'}
        </p>
      </div>
      <span class="page-head__rule"></span>
      <Button icon="plus" data-open="new-collection">New collection</Button>
    </div>

    <div id="m5" class="msg"></div>

    <div class="crow__columns" aria-hidden="true">
      <span class="crow__col-name">Collection</span>
      <span class="crow__rule"></span>
      <span class="crow__col-count">Products</span>
    </div>

    <ul class="crow-list" id="collectionList" aria-labelledby="h-collections">
      {
        collections.map((c, i) => (
          <li
            class="crow"
            data-id={c.id}
            data-version={c.version}
            data-name={c.name}
            data-order={String(c.sortOrder ?? i + 1)}
            data-slug={c.slug}
          >
            <div class="crow__head">
              <span class="crow__name">{c.name}</span>
              <span class="crow__rule" />
              <span class="crow__count">
                {rugCount(c.name)} {rugCount(c.name) === 1 ? 'product' : 'products'}
              </span>
              <button type="button" class="btn btn--secondary" data-act="edit">
                Edit
              </button>
            </div>
            {c.description && <p class="crow__description">{c.description}</p>}
            {c.description && (
              <button type="button" class="crow__more" data-act="expand">
                See more
              </button>
            )}
            <div class="crow__edit" hidden>
              <input class="input" data-field="name" value={c.name} aria-label={`Name of ${c.name}`} />
              {/* A textarea, not a one-line field (owner, 2026-09-20): a collection description runs
                  to a paragraph and the sheet takes 1000 characters, so the control has to be big
                  enough to write one in and to say how much room is left. */}
              <div class="crow__desc">
                <textarea
                  class="input crow__desc-box"
                  data-field="description"
                  rows="4"
                  maxlength={DESCRIPTION_MAX}
                  aria-label={`Description of ${c.name}`}
                  set:text={c.description}
                />
                <p class="hint crow__desc-count" data-desc-count />
              </div>
              <button type="button" class="btn btn--primary" data-act="save">
                Save
              </button>
              <button type="button" class="btn btn--ghost" data-act="cancel">
                Cancel
              </button>
              <button type="button" class="btn btn--destructive" data-act="delete">
                Delete
              </button>
            </div>
          </li>
        ))
      }
    </ul>

    {
      collections.length === 0 && (
        <EmptyState
          type="first-run"
          title="No collections yet"
          message="Collections group the catalogue for the buyer. A rug can sit in several at once."
        />
      )
    }

    <Modal id="new-collection" title="New collection">
      <p>Collections group the catalogue for the buyer. A rug can sit in several at once.</p>
      <div class="modal__fields">
        <Input name="c_name" label="Name" placeholder="Shiraz" hint="Required, and must be unique." />
        <Input
          type="textarea"
          name="c_description"
          label="Description"
          hint="Shown to customers under the collection name."
        />
      </div>
      <Fragment slot="footer">
        <Button style="ghost" data-close="new-collection">Cancel</Button>
        <Button id="btnAddCollection" icon="plus">Create collection</Button>
      </Fragment>
    </Modal>

    <div id="m6" class="msg"></div>
  </section>

  <script is:inline type="application/json" id="admin-data" set:html={jsonForScript(data)} />
  <script>
    import { initCollections } from '../../scripts/admin/collections.ts';
    import { initOverlays } from '../../scripts/ui/overlay.ts';
    initCollections();
    initOverlays();
  </script>
</AdminLayout>

<style is:global>
  [hidden] {
    display: none !important;
  }
  td.acts {
    white-space: nowrap;
  }
  td.acts .chip + .chip {
    margin-left: 4px;
  }
  td input {
    padding: 6px 8px;
    font-size: 13px;
    min-width: 120px;
  }
  .chip .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border: 1px solid var(--rule);
    vertical-align: middle;
  }
</style>
