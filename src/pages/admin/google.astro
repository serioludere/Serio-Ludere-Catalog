---
// /admin/google — connect the studio's Google account from the browser.
//
// This replaces `npm run google:auth` for everyday use. That script still works and is still the
// right tool on a laptop during first setup, but it needs a terminal beside the file that holds
// `.env`, which a deployed container does not have. Here the owner clicks Connect, consents, and the
// site stores the refresh token itself and starts using it on the next request.
//
// The page is deliberately explicit about *how long a connection lasts*, because the usual reason
// one dies is a setting in the Google Cloud console rather than anything in this codebase.
export const prerender = false;

import { GOOGLE_AUTH_MODE, GOOGLE_OAUTH_CLIENT_ID } from 'astro:env/server';
import AdminLayout from '../../components/admin/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import { adminRuntime } from '../../lib/admin/http.ts';
import { googleAuthAdvice, missingScopes, redirectUriFor } from '../../lib/google/oauth.ts';
import { getGoogleConnection, getGoogleStore, getSheetIdStore, sheetIdIfAny } from '../../lib/runtime.ts';

const mode = GOOGLE_AUTH_MODE;
const connection = getGoogleConnection();
const health = connection?.health();
const store = getGoogleStore();
const redirectUri = redirectUriFor(adminRuntime.siteUrl);
const configured = Boolean(GOOGLE_OAUTH_CLIENT_ID);
// Scopes are only known for a token this site stored itself. One inherited from the environment
// was granted somewhere else, so claiming its permissions are "missing" would be a guess, and a
// wrong one — the CLI grants the same two.
const scopesKnown = health?.source === 'stored';
const missing = scopesKnown ? missingScopes(health.scopes) : [];
const advice = health?.connected ? googleAuthAdvice(health.scopes, { scopesKnown }) : [];

const outcome = Astro.url.searchParams.get('google');
const detail = (Astro.url.searchParams.get('detail') ?? '').slice(0, 200);
const MESSAGES: Record<string, string> = {
  connected: 'Connected. The site will keep itself signed in from here.',
  denied: 'You cancelled, or Google refused the request.',
  expired: 'That authorisation took too long or was already used.',
  bad_state: 'The reply did not match the request, so it was rejected.',
  no_code: 'Google sent no authorisation code.',
  not_configured: 'The OAuth client id and secret are not set.',
  failed: 'The exchange with Google failed.',
};
const message = outcome ? (MESSAGES[outcome] ?? 'Something went wrong.') : undefined;
// What happened to the catalogue sheet right after connecting (the callback creates it when none exists).
const sheetOutcome = Astro.url.searchParams.get('sheet');
const SHEET_MESSAGES: Record<string, string> = {
  created: 'Your catalogue sheet was created in your Google Drive, and the site is reading it.',
  failed: 'The catalogue sheet could not be created automatically.',
  skipped: 'The catalogue sheet was not created automatically.',
};
const sheetMessage = sheetOutcome ? (SHEET_MESSAGES[sheetOutcome] ?? undefined) : undefined;

// The catalogue sheet. `npm run sheet:init` assumes a developer with a terminal and a .env to write
// the new id into; the person setting this site up is usually the studio. So when a Google account
// is connected and there is no sheet yet, the admin offers to create one.
const sheetId = sheetIdIfAny();
const sheetStore = getSheetIdStore();
const storedSheet = sheetStore.read();
const sheetFromEnv = Boolean(sheetId && !storedSheet);
const canProvision = Boolean(health?.connected) && !sheetId && sheetStore.durable;
---

<AdminLayout title="Serio Ludere — Google" active="google">
  <div class="page-head">
    <div class="page-head__titles">
      <h1 class="page-head__title">Google</h1>
      <p class="page-head__count">
        The account this site reads the sheet and Drive with, and the catalogue sheet itself.
      </p>
    </div>
  </div>
  {
    message && (
      <div class:list={['msg', 'on', outcome === 'connected' ? 'ok' : 'err']}>
        {message} {sheetOutcome ? '' : detail}
      </div>
    )
  }
  {
    sheetMessage && (
      <div class:list={['msg', 'on', sheetOutcome === 'created' ? 'ok' : 'err']}>
        {sheetMessage} {detail}
      </div>
    )
  }

  <section class="stack" aria-labelledby="h-google">
    <h3 id="h-google">Google account</h3>

    {
      mode === 'service_account' ? (
        <p class="hint">
          This site signs in to Google with a server key, so there is nothing to connect here.
        </p>
      ) : !configured ? (
        <p class="hint">
          Google sign-in has not been set up on this server yet. Ask your developer to add the Google client
          details.
        </p>
      ) : (
        <>
          <dl class="kv">
            <div>
              <dt>Status</dt>
              <dd class:list={['status', health?.connected ? 'active' : 'revoked']}>
                {health?.connected ? 'connected' : 'not connected'}
              </dd>
            </div>
            {health?.account && (
              <div>
                <dt>Account</dt>
                <dd class="mono">{health.account}</dd>
              </div>
            )}
            <div>
              <dt>Permissions</dt>
              <dd class="mono">
                {health?.scopes.length
                  ? health.scopes.join(' ')
                  : scopesKnown
                    ? '—'
                    : 'not recorded (connected on the server)'}
              </dd>
            </div>
            <div>
              <dt>Connected</dt>
              <dd class="mono">{health?.connectedAt ?? '—'}</dd>
            </div>
            <div>
              <dt>Last used</dt>
              <dd class="mono">{health?.lastRefreshAt ?? 'never'}</dd>
            </div>
            <div>
              <dt>Connected via</dt>
              <dd>{health?.source === 'stored' ? 'this page' : 'the server'}</dd>
            </div>
          </dl>

          {health?.lastError && <div class="msg err on">Last problem: {health.lastError}</div>}

          {missing.length > 0 && (
            <div class="msg err on">
              Google did not grant everything the site needs. Connect again and approve both permissions.
            </div>
          )}

          {health?.connected && !scopesKnown && (
            <p class="hint">
              This connection was set up on the server, so the site cannot show which permissions it has.
              Press Reconnect to connect from here instead.
            </p>
          )}

          {!store.durable && (
            <div class="msg busy on">
              This server cannot keep the connection after a restart. Ask your developer to enable persistent
              storage.
            </div>
          )}

          <div class="actions">
            <a class="btn btn--primary" href="/api/admin/google/start?next=/admin/google">
              {health?.connected ? 'Reconnect' : 'Connect Google account'}
            </a>
            {health?.connected && (
              <button class="btn btn--destructive" id="btnDisconnect" type="button">
                Disconnect
              </button>
            )}
          </div>
          <div id="m12" class="msg" />

          <h4>How long it lasts</h4>
          <ul class="hint">
            {(advice.length ? advice : googleAuthAdvice([], { scopesKnown: false })).map((line) => (
              <li>{line}</li>
            ))}
          </ul>

          <h4>First-time setup</h4>
          <p class="hint">
            Before connecting for the first time, your developer must register this address with Google:
          </p>
          <div class="row">
            {/* The value here has to be pasted into the Google Cloud console exactly, so the field
                deserves a visible name rather than an aria-label the eye never sees. Wording is the
                aria-label's, verbatim; the attribute goes, since it would override the label. */}
            <div class="grow field">
              <label class="field__label" for="redirectUri">
                Authorised redirect URI
              </label>
              <input id="redirectUri" readonly value={redirectUri} />
            </div>
            <button class="btn btn--secondary" id="btnCopyRedirect" type="button">
              Copy
            </button>
          </div>
        </>
      )
    }
  </section>

  <section class="stack" aria-labelledby="h-sheet">
    <h3 id="h-sheet">Catalogue sheet</h3>

    {
      sheetId ? (
        <>
          <p class="hint">
            {sheetFromEnv
              ? 'The catalogue sheet is configured on the server.'
              : `Created ${storedSheet?.createdAt?.slice(0, 10) ?? ''}${storedSheet?.createdBy ? ` in ${storedSheet.createdBy}` : ''}.`}
          </p>
          <p class="hint">
            <a href={`https://docs.google.com/spreadsheets/d/${sheetId}/edit`} target="_blank" rel="noopener">
              Open the sheet in Google Sheets
            </a>
          </p>
        </>
      ) : !health?.connected ? (
        <p class="hint">Connect a Google account first — the catalogue is created in that account’s Drive.</p>
      ) : !sheetStore.durable ? (
        /* Without DATA_DIR the new id is remembered for this process only, so the next restart would
           show this screen again and invite a SECOND sheet — leaving the first orphaned with the
           studio's data in it. Refusing is kinder than the silent version of that. */
        <div class="msg err on">
          This server cannot remember a new sheet after a restart, so one cannot be created here. Ask your
          developer to enable persistent storage.
        </div>
      ) : (
        <>
          <p class="hint">
            No catalogue sheet yet. One is normally created the moment a Google account is connected; if that
            did not happen, create it now. It starts empty.
          </p>
          <div class="row">
            <div class="grow">
              <Input
                type="text"
                id="sheetTitle"
                name="title"
                label="Name it in your Drive"
                value="Serio Ludere — Catalogue"
              />
            </div>
          </div>
          <div class="actions">
            <Button id="btnCreateSheet" style="primary">
              Create the catalogue sheet
            </Button>
          </div>
          <div id="mSheet" class="msg" />
        </>
      )
    }
  </section>

  <script>
    import { initGoogle } from '../../scripts/admin/google.ts';
    initGoogle();
  </script>
</AdminLayout>

<style is:global>
  .kv {
    display: grid;
    gap: var(--stack-xs);
    margin: 0;
  }
  .kv > div {
    display: flex;
    gap: var(--stack-md);
  }
  .kv dt {
    flex: 0 0 140px;
    color: var(--ink-muted);
    font-family: var(--heading);
    font-weight: var(--weight-label);
    text-transform: none;
    font-size: var(--size-label);
    letter-spacing: 0.02em;
    padding-top: 2px;
  }
  .kv dd {
    margin: 0;
  }
</style>
