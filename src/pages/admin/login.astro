---
// /admin/login (docs/ADMIN_SPEC.md §2.1, §8.3, §9.3): a plain form POST that works without JS.
// Order on POST: verifyPassword → cookie → 303 to `next`. A wrong password is a plain 401.
//
// No attempt limit (owner, 2026-09-17): the login used to back off and lock after repeated misses,
// and the studio found itself locked out of its own panel. There is one owner and one password.
// The admin gate (src/middleware.ts) already answered 404 when the panel is not configured.
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import AdminLogo from '../../components/admin/AdminLogo.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import { requestIpHash, socketAddressOf } from '../../lib/api.ts';
import { newSession, setSessionCookie, verifyPassword } from '../../lib/admin/auth.ts';
import { adminRuntime, recordAuditEvent } from '../../lib/admin/http.ts';
import { sanitiseNext } from '../../lib/admin/login.ts';

const { request, cookies, locals, url } = Astro;
if (!adminRuntime.configured) {
  return new Response('Not found', { status: 404, headers: { 'cache-control': 'no-store' } });
}

let next = sanitiseNext(url.searchParams.get('next'));
if (locals.admin) return Astro.redirect(next, 303);

let message = '';
let status = 200;

if (request.method === 'POST') {
  let form: FormData | undefined;
  try {
    form = await request.formData();
  } catch {
    form = undefined;
  }
  const password = String(form?.get('password') ?? '');
  next = sanitiseNext(form?.get('next') ?? next);
  if (verifyPassword(adminRuntime.passwordHash, password)) {
    const now = Date.now();
    const session = newSession(adminRuntime.user, now);
    setSessionCookie(cookies, session, adminRuntime.secret!, adminRuntime.isSecureSite, now);
    await recordAuditEvent({
      action: 'auth.login',
      targetTab: '-',
      targetId: adminRuntime.user,
      ipHash: requestIpHash(request, socketAddressOf(Astro)),
      requestId: locals.requestId ?? 'none',
      after: { user: adminRuntime.user, absoluteExpiry: new Date(session.abs).toISOString() },
    });
    return Astro.redirect(next, 303);
  }
  // Copy from Figma 47:44 (A2). There is no username, so naming the password as the problem tells an
  // attacker nothing a generic message would not.
  status = 401;
  message = 'That password is not correct.';
}

Astro.response.status = status;
---

<AdminLayout title="Serio Ludere — Admin login" nav={false} sub="Admin — sign in" mode="admin-dark">
  <!--
    A1 · Login — default (Figma 47:3), A2 · wrong password (47:28). The rate-limited A3 state went
    with the attempt limit (owner, 2026-09-17).

    One 400-wide card centred on the page ground; A2 reddens the field border and says why.

    Black background, everything else the mode's own default (owner, 2026-09-17) — see
    [data-mode='admin-dark'] in src/styles/modes.css. The "Admin" label under the logo is gone too;
    the logo alone is the whole brand block now.

    The form still posts without JavaScript. The reveal eye on the password field is the one thing
    that needs it, and Input's own script adds it progressively.
  -->
  <form method="post" action="/admin/login" class="alogin">
    <input type="hidden" name="next" value={next} />

    <div class="alogin__brand">
      <AdminLogo />
    </div>

    <Input
      type="password"
      name="password"
      label="Password"
      autocomplete="current-password"
      required
      error={message || undefined}
    />

    <Button type="submit" style="primary" class="alogin__go">Enter</Button>
  </form>
</AdminLayout>

<style>
  /* The card: 400 wide, centred, on the page ground. Figma 47:4 places it at x=520 in a 1440 frame,
     which is the centre — so it is centred rather than positioned. */
  .alogin {
    box-sizing: border-box;
    width: 400px;
    max-width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    /* 47:4 gap is --fieldset-gap (12); this repo already carries that value as --stack-md. */
    gap: var(--stack-md);
    padding: var(--section-gap);
    border: var(--rule-width) solid var(--rule);
    background: var(--surface);
  }

  .alogin__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--stack-xs);
  }

  .alogin__brand :global(.admin-logo) {
    width: 160px;
    height: auto;
    color: var(--ink);
  }

  /* 47:19 is full-bleed inside the card. */
  .alogin__go {
    width: 100%;
  }
</style>
