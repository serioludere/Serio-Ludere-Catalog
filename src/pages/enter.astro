---
// /enter — the site password (owner, 2026-09-15). One shared password opens the public catalogue
// for thirty days on this browser. A plain form POST, so it works without JavaScript; the reveal eye
// is the one progressive extra. Failures share one message and are throttled per address before
// the password is checked, the way the admin and customer gates do it.
export const prerender = false;

import Layout from '../components/Layout.astro';
import Wordmark from '../components/Wordmark.astro';
import { verifyPassword } from '../lib/admin/auth.ts';
import { requestIpHash, socketAddressOf } from '../lib/api.ts';
import type { RateTable } from '../lib/currency.ts';
import {
  ENTER_PATH,
  makeSiteToken,
  sanitiseSiteNext,
  SITE_SESSION_MS,
  siteCookieName,
  verifySiteToken,
} from '../lib/site/gate.ts';
import { siteRuntime } from '../lib/site/http.ts';
import { STUDIO_EMAIL, STUDIO_NAME } from '../lib/studio.ts';

Astro.cache?.set(false);
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

// Nothing to enter when the gate is off.
if (!siteRuntime.enabled) return Astro.redirect('/', 303);

const { request, cookies, url } = Astro;
let next = sanitiseSiteNext(url.searchParams.get('next'));
const cookieName = siteCookieName(siteRuntime.isSecureSite);
const already =
  siteRuntime.secret !== undefined &&
  verifySiteToken(cookies.get(cookieName)?.value, siteRuntime.secret, Date.now());
if (already && request.method !== 'POST') return Astro.redirect(next, 303);

let message = '';
let status = 200;

if (request.method === 'POST') {
  let form: FormData | undefined;
  try {
    form = await request.formData();
  } catch {
    form = undefined;
  }
  const password = String(form?.get('password') ?? '');
  next = sanitiseSiteNext(form?.get('next') ?? next);
  const ip = requestIpHash(request, socketAddressOf(Astro));
  const check = siteRuntime.throttle.check(ip);
  if (!check.ok) {
    status = 429;
    Astro.response.headers.set('retry-after', String(Math.max(1, check.retryAfterSec)));
    message = `Too many attempts. Wait ${check.retryAfterSec} seconds and try again.`;
  } else if (!siteRuntime.secret) {
    status = 503;
    message = 'The catalogue password is not fully set up on this server yet. Please contact the studio.';
  } else if (password && verifyPassword(siteRuntime.passwordHash, password)) {
    siteRuntime.throttle.succeed(ip);
    const now = Date.now();
    cookies.set(cookieName, makeSiteToken(now + SITE_SESSION_MS, siteRuntime.secret), {
      httpOnly: true,
      secure: siteRuntime.isSecureSite,
      sameSite: 'lax',
      path: '/',
      maxAge: Math.floor(SITE_SESSION_MS / 1000),
    });
    return Astro.redirect(next, 303);
  } else {
    const failure = siteRuntime.throttle.fail(ip);
    status = 401;
    if (failure.retryAfterSec) Astro.response.headers.set('retry-after', String(failure.retryAfterSec));
    message = failure.retryAfterSec
      ? `That password is not correct. Try again in ${failure.retryAfterSec} seconds.`
      : 'That password is not correct.';
  }
}

Astro.response.status = status;

// The shell wants a rate table for its pre-paint step; this page prices nothing.
const rates: RateTable = { rates: { USD: 1 }, symbols: { USD: '$' } };
---

<Layout title={`${STUDIO_NAME} — Private catalogue`} rates={rates}>
  <main class="gate">
    <div class="gate-card">
      <a href="/" class="gate-home" aria-label={`${STUDIO_NAME} catalogue`}><Wordmark /></a>
      <p class="eyebrow">Private catalogue</p>
      <h1 class="gate-title">Enter the password to view the collection</h1>
      <form method="post" action={ENTER_PATH} class="gate-form">
        <input type="hidden" name="next" value={next} />
        <label class="sr-only" for="site-password">Password</label>
        <input
          class="gate-input"
          id="site-password"
          name="password"
          type="password"
          placeholder="Password"
          autocomplete="current-password"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          required
          maxlength="200"
          autofocus
        />
        <button type="submit" class="gate-go">View the catalogue</button>
        {
          message && (
            <p class="gate-error" role="alert">
              {message}
            </p>
          )
        }
      </form>
      <p class="gate-fine">
        The password was sent to you by the studio. Questions?{' '}
        <a href={`mailto:${STUDIO_EMAIL}`}>{STUDIO_EMAIL}</a>
      </p>
    </div>
  </main>
</Layout>

<style>
  .gate {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 48px var(--page-x, 5vw) 64px;
  }
  .gate-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: min(420px, 100%);
  }
  .gate-home {
    display: block;
    color: inherit;
    text-decoration: none;
    margin-bottom: 6px;
  }
  .gate-home :global(.wordmark) {
    width: min(260px, 70vw);
  }
  .gate-title {
    font: 500 clamp(20px, 2.2vw, 26px) / 1.25 var(--body);
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin-bottom: 8px;
  }
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gate-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-1);
    background: var(--paper-deep);
    color: var(--ink);
    font: 400 15px/1.4 var(--body);
  }
  .gate-input::placeholder {
    color: var(--ink-soft);
  }
  .gate-input:hover {
    border-color: var(--ink-soft);
  }
  .gate-input:focus-visible {
    outline: var(--focus);
    outline-offset: 2px;
  }
  .gate-go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--radius-1);
    background: var(--ink);
    color: var(--paper);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .gate-go:hover {
    background: var(--accent);
  }
  .gate-error {
    font: 400 13px/1.5 var(--body);
    color: var(--accent);
  }
  .gate-fine {
    font: 400 11px/1.7 var(--mono);
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }
  .gate-fine a {
    color: inherit;
  }
</style>
